# Core-facing FPU reachability cover.
[options]
mode cover
depth 12
[engines]
smtbmc boolector
[script]
plugin -i slang
read_slang -D FORMAL --top fpu_formal isa_pkg.sv fpu_pkg.sv core_pkg.sv fpu_datapath_stub.sv fpu.sv fpu_env.sv
prep -top fpu_formal
[files]
../../../rtl/isa/isa_pkg.sv
../../../rtl/core/fpu/fpu_pkg.sv
../../../rtl/core/core_pkg.sv
env/fpu_datapath_stub.sv
../../../build/formal/fpu/generated/fpu.sv
env/fpu_env.sv
env/fpu_assumptions.sv
env/fpu_coverpoints.sv
properties/fpu_reset.sv
properties/fpu_handshake.sv
properties/fpu_simple.sv
