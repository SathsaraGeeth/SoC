# System-array address-generator reachability cover.
[options]
mode cover
depth 40
[engines]
smtbmc boolector
[script]
plugin -i slang
read_slang -D FORMAL --top sys_address_generator_formal isa_pkg.sv fpu_pkg.sv core_pkg.sv topology_pkg.sv memory_pkg.sv sys_cnfg_pkg.sv sys_address_generator.sv sys_address_generator_env.sv
prep -top sys_address_generator_formal
[files]
../../../rtl/isa/isa_pkg.sv
../../../rtl/core/fpu/fpu_pkg.sv
../../../rtl/core/core_pkg.sv
../../../rtl/soc/topology_pkg.sv
../../../rtl/memory/memory_pkg.sv
../../../rtl/sys_arr/sys_cnfg_pkg.sv
../../../rtl/sys_arr/sys_address_generator.sv
env/sys_address_generator_env.sv
env/sys_address_generator_assumptions.sv
env/sys_address_generator_coverpoints.sv
properties/sys_address_generator_reset.sv
properties/sys_address_generator_protocol.sv
properties/sys_address_generator_first.sv
