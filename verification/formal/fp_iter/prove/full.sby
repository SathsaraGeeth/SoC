# FP iteration-controller safety proof.
[options]
mode prove
depth 8
[engines]
smtbmc boolector
[script]
plugin -i slang
read_slang -D FORMAL --top fp_iter_formal isa_pkg.sv fpu_pkg.sv fpu_functions_pkg.sv fpu_iter.sv fp_iter_env.sv
prep -top fp_iter_formal
