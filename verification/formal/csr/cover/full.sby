# CSR reachability cover.

[options]
mode cover
depth 8

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL --top csr_formal isa_pkg.sv core_pkg.sv regfile.sv csr.sv csr_env.sv
prep -top csr_formal

[files]
../../../rtl/isa/isa_pkg.sv
../../../rtl/core/core_pkg.sv
../../../build/formal/csr/generated/regfile.sv
../../../build/formal/csr/generated/csr.sv
env/csr_env.sv
env/csr_assumptions.sv
env/csr_coverpoints.sv
properties/csr_reset.sv
properties/csr_reads.sv
properties/csr_privilege.sv

