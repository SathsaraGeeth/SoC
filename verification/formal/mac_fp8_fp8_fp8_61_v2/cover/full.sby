# FP8 MAC v2 reachability cover.
[options]
mode cover
depth 20
[engines]
smtbmc boolector
[script]
plugin -i slang
read_slang -D FORMAL --top mac_fp8_formal isa_pkg.sv fpu_pkg.sv core_pkg.sv topology_pkg.sv memory_pkg.sv sys_cnfg_pkg.sv mac_fp8_cnfg_pkg.sv mac_fp8_v2.sv mac_fp8_env.sv
prep -top mac_fp8_formal
[files]
../../../rtl/isa/isa_pkg.sv
../../../rtl/core/fpu/fpu_pkg.sv
../../../rtl/core/core_pkg.sv
../../../rtl/soc/topology_pkg.sv
../../../rtl/memory/memory_pkg.sv
../../../rtl/sys_arr/sys_cnfg_pkg.sv
mac_fp8_cnfg_pkg.sv ../../../rtl/sys_arr/mac_fp8_fp8_fp8_61_cnfg_pkg.sv
mac_fp8_v2.sv ../../../build/formal/mac_fp8_fp8_fp8_61_v2/generated/mac_fp8_fp8_fp8_61_v2.sv
env/mac_fp8_env.sv
env/mac_fp8_assumptions.sv
env/mac_fp8_coverpoints.sv
properties/mac_fp8_reset.sv
properties/mac_fp8_pipeline.sv
