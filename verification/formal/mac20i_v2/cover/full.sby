# Integer MAC v2 reachability cover.
[options]
mode cover
depth 10
[engines]
smtbmc boolector
[script]
plugin -i slang
read_slang -D FORMAL --top mac20i_v2_formal isa_pkg.sv fpu_pkg.sv core_pkg.sv topology_pkg.sv memory_pkg.sv sys_cnfg_pkg.sv common.sv mac20i_v2.sv mac20i_v2_env.sv
prep -top mac20i_v2_formal
[files]
../../../rtl/isa/isa_pkg.sv
../../../rtl/core/fpu/fpu_pkg.sv
../../../rtl/core/core_pkg.sv
../../../rtl/soc/topology_pkg.sv
../../../rtl/memory/memory_pkg.sv
../../../rtl/sys_arr/sys_cnfg_pkg.sv
../../../rtl/sys_arr/common.sv
../../../build/formal/mac20i_v2/generated/mac20i_v2.sv
env/mac20i_v2_env.sv
env/mac20i_v2_assumptions.sv
env/mac20i_v2_coverpoints.sv
properties/mac20i_v2_reset.sv
properties/mac20i_v2_pipeline.sv
