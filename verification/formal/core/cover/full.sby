[options]
mode cover
depth 20

[engines]
smtbmc boolector

[script]
plugin -i slang
read_slang -D FORMAL --top core_formal isa_pkg.sv fpu_pkg.sv fpu_functions_pkg.sv core_pkg.sv topology_pkg.sv memory_pkg.sv decoder.sv regfile.sv alu.sv csr.sv fpu_iter.sv fpu_datapath.sv fpu.sv circular_buffer.sv core.sv core_env.sv
prep -top core_formal
flatten
simplemap
memory_nordff
memory_map
opt_clean
scc -select
select -set cover_scc
select @cover_scc %co
cutpoint
select -clear

[files]
../../../rtl/isa/isa_pkg.sv
../../../rtl/core/fpu/fpu_pkg.sv
../../../rtl/core/fpu/fpu_functions_pkg.sv
../../../rtl/core/core_pkg.sv
../../../rtl/soc/topology_pkg.sv
../../../rtl/memory/memory_pkg.sv
decoder.sv ../../../build/formal/core/generated/decoder.sv
regfile.sv ../../../build/formal/core/generated/regfile.sv
alu.sv ../../../build/formal/core/generated/alu.sv
csr.sv ../../../build/formal/core/generated/csr.sv
../../../rtl/core/fpu/fpu_iter.sv
fpu_datapath.sv ../../../rtl/core/fpu/fpu.sv
fpu.sv ../../../build/formal/core/generated/fpu.sv
../../../rtl/common/fifo/circular_buffer.sv
core.sv ../../../build/formal/core/generated/core.sv
env/core_env.sv
env/core_assumptions.sv
env/core_coverpoints.sv
