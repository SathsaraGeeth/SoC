`timescale 1ns/1ps
`default_nettype none

import core_pkg::*;
import memory_pkg::*;
import topology_pkg::*;
import isa_pkg::*;
import sys_cnfg_pkg::*;

module soc_multi (
    input  logic                                        i_clk,
    input  logic                                        i_rst_n,
    input  logic                                        i_uart_rx,
    input  logic                                        i_host_console_pending,
    output logic                                        o_uart_tx,
    output logic                                        o_sim_page_msg_valid,
    output logic [PAGE_MSG_W-1:0]                       o_sim_page_msg,
    output logic                                        o_page_req_we,
    output logic                                        o_page_req_valid,
    input  logic                                        i_page_req_ready,
    output logic [VIR_ADDR_W-1:0]                       o_page_req_addr,
    output logic [LINE_W-1:0]                           o_page_req_wdata,
    input  logic [VIR_ADDR_W-1:0]                       i_page_resp_addr,
    input  logic                                        i_page_resp_we,
    input  logic [LINE_W-1:0]                           i_page_resp_wdata,
    input  logic                                        i_page_resp_valid,
    output logic                                        o_page_resp_ready,
    input  logic                                        i_page_transfer_done,
    output logic [31:0]                                 m_axi4_page_awaddr,
    output logic [7:0]                                  m_axi4_page_awlen,
    output logic [2:0]                                  m_axi4_page_awsize,
    output logic [1:0]                                  m_axi4_page_awburst
);
    /*--- */
    localparam NUM_CORES = NUM_CLUSTER * CORES_PER_CLUSTER;
    localparam int CORE_THRD_W = $clog2(NUM_HW_THRDS);
    localparam int NUM_SYS_PORTS = memory_pkg::NUM_SYS_RW_PORTS;
    // i_rst_n is asynchronous at the SoC boundary.  Keep assertion
    // asynchronous, but release each independently resettable block only
    // after it has been synchronized to its receiving clock.
    logic                                               rst_fabric_n;
    logic                                               rst_cluster_n [NUM_CLUSTER-1:0];
    logic                                               rst_mem_n     [NUM_MEM-1:0];
    logic                                               rst_periph_n;
    logic                                               rst_accel_n;
    logic                                               w_core_clk                                      [NUM_CORES-1:0];
    logic                                               w_core_rst_n                                    [NUM_CORES-1:0];
    logic [XLEN-1:0]                                    w_core_thrd_id_vec                              [NUM_CORES-1:0] [NUM_HW_THRDS-1:0];
    logic [NUM_HW_THRDS-1:0]                            w_core_wake_intr_vec                            [NUM_CORES-1:0];
    logic                                               w_core_req_instr_ready                          [NUM_CORES-1:0];
    logic [VIR_ADDR_W-1:0]                              w_core_req_instr_addr                           [NUM_CORES-1:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]                    w_core_req_instr_thrd_id                        [NUM_CORES-1:0];
    logic [1:0]                                         w_core_req_instr_priv                           [NUM_CORES-1:0];
    logic                                               w_core_req_instr_valid                          [NUM_CORES-1:0];
    logic                                               w_core_resp_instr_ready                         [NUM_CORES-1:0];
    logic [XLEN-1:0]                                    w_core_resp_instr                               [NUM_CORES-1:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]                    w_core_resp_instr_thrd_id                       [NUM_CORES-1:0];
    logic                                               w_core_resp_instr_valid                         [NUM_CORES-1:0];
    logic                                               w_core_req_data_ready                           [NUM_CORES-1:0];
    logic [VIR_ADDR_W-1:0]                              w_core_req_data_addr                            [NUM_CORES-1:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]                    w_core_req_data_thrd_id                         [NUM_CORES-1:0];
    logic [1:0]                                         w_core_req_data_priv                            [NUM_CORES-1:0];
    logic                                               w_core_req_data_rw                              [NUM_CORES-1:0];
    logic                                               w_core_req_data_lq                              [NUM_CORES-1:0];
    logic                                               w_core_req_data_sc                              [NUM_CORES-1:0];
    logic [XLEN/8-1:0]                                  w_core_req_data_wstrb                           [NUM_CORES-1:0];
    logic [XLEN-1:0]                                    w_core_req_data_wdata                           [NUM_CORES-1:0];
    logic                                               w_core_req_data_valid                           [NUM_CORES-1:0];
    logic                                               w_core_resp_data_ready                          [NUM_CORES-1:0];
    logic [XLEN-1:0]                                    w_core_resp_data_rdata                          [NUM_CORES-1:0];
    logic                                               w_core_resp_data_sc_ok                          [NUM_CORES-1:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]                    w_core_resp_data_thrd_id                        [NUM_CORES-1:0];
    logic                                               w_core_resp_data_valid                          [NUM_CORES-1:0];
    logic [NUM_HW_THRDS-1:0]                            w_core_irq_timer_vec                            [NUM_CORES-1:0];
    logic [NUM_HW_THRDS-1:0]                            w_core_timer_req_valid                          [NUM_CORES-1:0];
    logic [NUM_HW_THRDS-1:0]                            w_core_timer_resp_valid                         [NUM_CORES-1:0];
    logic [XLEN-1:0]                                    w_core_timer_resp_rdata                         [NUM_CORES-1:0] [NUM_HW_THRDS-1:0];
    logic [PAGE_MSG_W-1:0]                              w_core_page_msg_instr                           [NUM_CORES-1:0];
    logic                                               w_core_page_msg_instr_valid                     [NUM_CORES-1:0];
    logic [PAGE_MSG_W-1:0]                              r_core_page_msg_instr                           [NUM_CORES-1:0];
    logic                                               r_core_page_msg_instr_valid                     [NUM_CORES-1:0];
    logic                                               w_core_page_msg_instr_ready                     [NUM_CORES-1:0];
    logic [PAGE_MSG_W-1:0]                              w_core_page_msg_data                            [NUM_CORES-1:0];
    logic                                               w_core_page_msg_data_ready                      [NUM_CORES-1:0];
    logic                                               w_core_page_msg_data_valid                      [NUM_CORES-1:0];
    logic [PAGE_MSG_W-1:0]                              r_core_page_msg_data                            [NUM_CORES-1:0];
    logic                                               r_core_page_msg_data_valid                      [NUM_CORES-1:0];
    logic [PAGE_MSG_W-1:0]                              w_core_page_msg                                 [NUM_CORES-1:0];
    logic                                               w_core_page_msg_ready                           [NUM_CORES-1:0];
    logic                                               w_core_page_msg_valid                           [NUM_CORES-1:0]; 
    logic                                               w_router_req_data_ready                         [NUM_CORES-1:0];
    logic [XLEN-1:0]                                    w_router_resp_data_rdata                        [NUM_CORES-1:0];
    logic                                               w_router_resp_data_sc_ok                        [NUM_CORES-1:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]                    w_router_resp_data_thrd_id                      [NUM_CORES-1:0];
    logic                                               w_router_resp_data_valid                        [NUM_CORES-1:0];

    logic                                               w_memory_clk                                    [NUM_MEM-1:0];
    logic                                               w_memory_rst_n                                  [NUM_MEM-1:0];
    logic                                               w_memory_req_we                                 [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [THRD_W-1:0]                                  w_memory_req_thrd                               [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_req_is_lr                              [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_req_is_sc                              [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [VIR_ADDR_W-1:0]                              w_memory_req_addr                               [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [XLEN/8-1:0]                                  w_memory_req_wstrb                              [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [XLEN-1:0]                                    w_memory_req_wdata                              [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_req_valid                              [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [1:0]                                         w_memory_req_priv                               [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_req_ready                              [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [THRD_W-1:0]                                  w_memory_resp_thrd                              [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_resp_sc_succ                           [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [XLEN-1:0]                                    w_memory_resp_rdata                             [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_resp_valid                             [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_resp_ready                             [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_page_msg_valid                         [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_page_msg_ready                         [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [PAGE_MSG_W-1:0]                              w_memory_page_msg                               [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_o_page_msg_ready                       [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               r_memory_o_page_msg_ready                       [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_o_page_msg_valid                       [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic [PAGE_MSG_W-1:0]                              w_memory_o_page_msg                             [NUM_MEM-1:0] [NUM_RW_PORTS-1:0];
    logic                                               w_memory_page_req_we                            [NUM_MEM-1:0];
    logic                                               w_memory_page_req_valid                         [NUM_MEM-1:0];
    logic [THRD_W-1:0]                                  w_memory_page_req_thrd                          [NUM_MEM-1:0];
    logic                                               w_memory_page_req_ready                         [NUM_MEM-1:0];
    logic [VIR_ADDR_W-1:0]                              w_memory_page_req_addr                          [NUM_MEM-1:0];
    logic [NUM_BANKS*XLEN-1:0]                          w_memory_page_req_wdata                         [NUM_MEM-1:0];
    logic [VIR_ADDR_W-1:0]                              w_memory_page_resp_addr                         [NUM_MEM-1:0];
    logic                                               w_memory_page_resp_we                           [NUM_MEM-1:0];
    logic [NUM_BANKS*XLEN-1:0]                          w_memory_page_resp_wdata                        [NUM_MEM-1:0];
    logic                                               w_memory_page_resp_valid                        [NUM_MEM-1:0];
    logic                                               w_memory_page_resp_ready                        [NUM_MEM-1:0];

    logic                                               w_uart_mmio_clk;
    logic                                               w_uart_mmio_rst_n;
    logic                                               w_uart_mmio_req_valid;
    logic                                               w_uart_mmio_req_ready;
    logic                                               w_uart_mmio_req_we;
    logic [THRD_W-1:0]                                  w_uart_mmio_req_thrd;
    logic                                               w_uart_mmio_req_is_lr;
    logic                                               w_uart_mmio_req_is_sc;
    logic [1:0]                                         w_uart_mmio_req_priv;
    logic [VIR_ADDR_W-1:0]                              w_uart_mmio_req_addr;
    logic [XLEN-1:0]                                    w_uart_mmio_req_wdata;
    logic [XLEN/8-1:0]                                  w_uart_mmio_req_wstrb;
    logic                                               w_uart_mmio_resp_valid;
    logic [63:0]                                        w_uart_mmio_resp_rdata;
    logic [THRD_W-1:0]                                  w_uart_mmio_resp_thrd;
    logic                                               w_uart_mmio_resp_sc_succ;
    logic                                               w_uart_mmio_resp_ready;
    logic                                               w_uart_mmio_rx;
    logic                                               w_uart_mmio_tx;
    logic                                               w_sys_mmio_req_valid                         [NUM_CLUSTER-1:0];
    logic                                               w_sys_mmio_req_ready                         [NUM_CLUSTER-1:0];
    logic [VIR_ADDR_W-1:0]                              w_sys_mmio_req_addr                          [NUM_CLUSTER-1:0];
    logic [XLEN-1:0]                                    w_sys_mmio_req_wdata                         [NUM_CLUSTER-1:0];
    logic [XLEN/8-1:0]                                  w_sys_mmio_req_wmask                         [NUM_CLUSTER-1:0];
    logic                                               w_sys_mmio_resp_valid                        [NUM_CLUSTER-1:0];
    logic [XLEN-1:0]                                    w_sys_mmio_resp_rdata                        [NUM_CLUSTER-1:0];
    logic                                               w_sys_mmio_resp_ready                        [NUM_CLUSTER-1:0];
    logic                                               w_sys_intr                                   [NUM_CLUSTER-1:0];
    logic [XLEN-1:0]                                    w_sys_intr_thrd                              [NUM_CLUSTER-1:0];
    logic [NUM_CORES-1:0]                               w_sys_mmio_grant;
    logic                                               w_sys_req_we                                 [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic [XLEN-1:0]                                    w_sys_req_thrd                               [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic                                               w_sys_req_is_lr                              [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic                                               w_sys_req_is_sc                              [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic [VIR_ADDR_W-1:0]                              w_sys_req_addr                               [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic [XLEN/8-1:0]                                  w_sys_req_wstrb                              [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic [XLEN-1:0]                                    w_sys_req_wdata                              [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic                                               w_sys_req_valid                              [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic                                               w_sys_req_ready                              [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic [XLEN-1:0]                                    w_sys_resp_thrd                              [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic                                               w_sys_resp_sc_succ                           [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic [XLEN-1:0]                                    w_sys_resp_rdata                             [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic                                               w_sys_resp_valid                             [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic                                               w_sys_resp_ready                             [NUM_CLUSTER-1:0] [NUM_SYS_PORTS-1:0];
    logic [THREADS_PER_CLUSTER-1:0]                     r_ipi_vector                                  [NUM_CORES-1:0];
    logic                                               r_ipi_resp_valid                              [NUM_CORES-1:0];
    logic [XLEN-1:0]                                    r_ipi_resp_rdata                              [NUM_CORES-1:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]                    r_ipi_resp_thrd                               [NUM_CORES-1:0];
    logic [7:0]                                         r_ipi_wake_hold                               [NUM_CORES-1:0];
    logic                                               r_oob_resp_valid                              [NUM_CORES-1:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]                    r_oob_resp_thrd                               [NUM_CORES-1:0];
    logic [$clog2(CORES_PER_CLUSTER > 1 ? CORES_PER_CLUSTER : 2)-1:0] r_sys_resp_core                 [NUM_CLUSTER-1:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]                    r_sys_resp_thrd                               [NUM_CLUSTER-1:0];
    logic [THRD_W-1:0]                                  r_sys_host_thrd                               [NUM_CLUSTER-1:0];
    logic [VTID_W-1:0]                                  r_sys_host_vtid                               [NUM_CLUSTER-1:0];
    logic                                               r_sys_host_vtid_valid                         [NUM_CLUSTER-1:0];
    logic [1:0]                                         r_sys_host_priv                               [NUM_CLUSTER-1:0];
    logic [THRD_W-1:0]                                  w_sys_cmd_host_thrd                           [NUM_CLUSTER-1:0];
    logic [VTID_W-1:0]                                  w_sys_cmd_host_vtid                           [NUM_CLUSTER-1:0];
    logic                                               w_sys_cmd_host_valid                          [NUM_CLUSTER-1:0];
    logic [VTID_W-1:0]                                  r_core_active_vtid                            [NUM_CORES-1:0] [NUM_HW_THRDS-1:0];

    reset_sync fabric_reset_sync (
        .i_clk         (i_clk),
        .i_async_rst_n (i_rst_n),
        .o_rst_n       (rst_fabric_n)
    );

    // The accelerator/system-core and peripheral domains are independently
    // resettable even though the current implementation uses i_clk for all
    // domains.  This keeps reset release local when a domain later receives
    // its own clock.
    reset_sync accel_reset_sync (
        .i_clk         (i_clk),
        .i_async_rst_n (i_rst_n),
        .o_rst_n       (rst_accel_n)
    );
    reset_sync periph_reset_sync (
        .i_clk         (i_clk),
        .i_async_rst_n (i_rst_n),
        .o_rst_n       (rst_periph_n)
    );
    localparam int IPI_WORDS = (THREADS_PER_CLUSTER + XLEN - 1) / XLEN;
    localparam int IPI_WORD_BYTES = XLEN / 8;
    localparam logic [VIR_ADDR_W-1:0] UART_BASE_ADDR     = 64'h0000_0010_0000_0000;
    localparam logic [VIR_ADDR_W-1:0] UART_END_ADDR      = UART_BASE_ADDR + 64'h3f;
    localparam logic [VIR_ADDR_W-1:0] FASTCON_RX_ADDR    = UART_BASE_ADDR + 64'h38;
    localparam logic [VIR_ADDR_W-1:0] IPI_BASE_ADDR      = 64'h0000_0010_0000_1000;
    localparam logic [VIR_ADDR_W-1:0] IPI_SIZE_BYTES     = 64'h0000_0000_0000_1000;
    localparam logic [VIR_ADDR_W-1:0] IPI_END_ADDR       = IPI_BASE_ADDR + IPI_SIZE_BYTES;
    localparam logic [VIR_ADDR_W-1:0] SYS_MMIO_BASE_ADDR = 64'h0000_0010_0100_0000;
    localparam logic [VIR_ADDR_W-1:0] SYS_MMIO_END_ADDR  = 64'h0000_0010_0100_0fff;

    /* topology */

    function automatic int get_c_x(int id);
        int c = 0;
        for (int y = 0; y < GRID_Y; y++) begin
            for (int x = 0; x < GRID_X; x++) begin
                if ((x+y) % 2 == 0) begin
                    if (c == id) return x;
                    c++;
                end
            end
        end
        return 0;
    endfunction

    function automatic int get_c_y(int id);
        int c = 0;
        for (int y = 0; y < GRID_Y; y++) begin
            for (int x = 0; x < GRID_X; x++) begin
                if ((x+y) % 2 == 0) begin
                    if (c == id) return y;
                    c++;
                end
            end
        end
        return 0;
    endfunction

    function automatic logic is_ipi_addr(input logic [VIR_ADDR_W-1:0] addr);
        begin
            is_ipi_addr = (addr >= IPI_BASE_ADDR) &&
                          (addr < IPI_END_ADDR) &&
                          (((addr - IPI_BASE_ADDR) % VIR_ADDR_W'(IPI_WORD_BYTES)) == 0);
        end
    endfunction

    function automatic int ipi_word_index(input logic [VIR_ADDR_W-1:0] addr);
        begin
            ipi_word_index = int'((addr - IPI_BASE_ADDR) / VIR_ADDR_W'(IPI_WORD_BYTES));
        end
    endfunction

    function automatic int get_m_id(int x, int y);
        int m = 0;
        for (int yy = 0; yy < GRID_Y; yy++) begin
            for (int xx = 0; xx < GRID_X; xx++) begin
                if ((xx+yy) % 2 != 0) begin
                    if (xx == x && yy == y) return m;
                    m++;
                end
            end
        end
        return -1;
    endfunction

    function automatic logic is_dummy_oob_data_addr(
        input logic [VIR_ADDR_W-1:0] addr,
        input logic [1:0] priv
    );
        return (priv != PRIV_MODE_U) && (addr[31:28] == 4'hf);
    endfunction

    function automatic logic is_sys_mmio_addr(
        input logic [VIR_ADDR_W-1:0] addr,
        input logic [1:0] priv
    );
        return (priv != PRIV_MODE_U) && (addr >= SYS_MMIO_BASE_ADDR) && (addr <= SYS_MMIO_END_ADDR);
    endfunction

    localparam logic [VIR_ADDR_W-1:0] TIMER_MMIO_BASE_ADDR = 64'h0000_0010_0200_0000;
    localparam logic [VIR_ADDR_W-1:0] TIMER_MMIO_SIZE      = 64'h0000_0000_0100_0000;
    function automatic logic is_timer_mmio_addr(
        input logic [VIR_ADDR_W-1:0] addr,
        input logic [1:0] priv
    );
        // Timer instances expose per-thread registers within one RV64 MMIO
        // page (for example +0x400).  Route the complete aperture, not just
        // the legacy first 16-byte register block.
        return (priv != PRIV_MODE_U) && (addr >= TIMER_MMIO_BASE_ADDR) &&
               (addr < (TIMER_MMIO_BASE_ADDR + TIMER_MMIO_SIZE));
    endfunction


    localparam int REGION_OFFSET_BITS = VIR_ADDR_W - 2 * MESH_COORD_BITS;
    function automatic logic [VIR_ADDR_W-1:0] local_region_addr(input logic [VIR_ADDR_W-1:0] addr);
        local_region_addr = addr & ((VIR_ADDR_W'(1) << REGION_OFFSET_BITS) - 1);
    endfunction

    function automatic logic [VIR_ADDR_W-1:0] memory_req_addr(
        input logic [VIR_ADDR_W-1:0] addr,
        input logic [1:0] priv
    );
        memory_req_addr = (priv == PRIV_MODE_U) ? addr : local_region_addr(addr);
    endfunction

    /* 
     * Boot Region 1-to-1 Bijection (Perfect Matching):
     * To prevent multiple clusters from booting out of the same memory region, 
     * every cluster is statically paired with exactly one memory region horizontally.
     * Even X clusters boot from East, Odd X clusters boot from West.
     */
    function automatic logic [VIR_ADDR_W-1:0] get_reset_vec(int id);
        int C_X = get_c_x(id);
        int C_Y = get_c_y(id);
        
        int M_X = (C_X % 2 == 0) ? (C_X + 1) : (C_X - 1);
        int M_Y = C_Y;
        
        // Region coordinates occupy the high address fields in RV64.  The
        // previous 32-bit shifts (28/24) left a 16 MiB offset in the local
        // address and made secondary boot fetches miss their TLB entry.
        return (VIR_ADDR_W'(M_Y) << (REGION_OFFSET_BITS + MESH_COORD_BITS)) |
               (VIR_ADDR_W'(M_X) << REGION_OFFSET_BITS);
    endfunction

    generate
        for(genvar i = 0; i < NUM_CLUSTER; i++) begin : gen_cluster
            for (genvar j = 0; j < CORES_PER_CLUSTER; j++) begin : gen_core
                core #(
                .RESET_VEC(get_reset_vec(i))
                ) core_u (
                .i_clk                                  (w_core_clk                                     [i*CORES_PER_CLUSTER+j]),
                .i_rst_n                                (w_core_rst_n                                   [i*CORES_PER_CLUSTER+j]),
                .i_thrd_id_vec                          (w_core_thrd_id_vec                             [i*CORES_PER_CLUSTER+j]),   
                .i_wake_intr_vec                        (w_core_wake_intr_vec                           [i*CORES_PER_CLUSTER+j]),
                .i_irq_timer_vec                        (w_core_irq_timer_vec                           [i*CORES_PER_CLUSTER+j]),
                .i_req_instr_ready                      (w_core_req_instr_ready                         [i*CORES_PER_CLUSTER+j]),
                .o_req_instr_addr                       (w_core_req_instr_addr                          [i*CORES_PER_CLUSTER+j]),
                .o_req_instr_thrd_id                    (w_core_req_instr_thrd_id                       [i*CORES_PER_CLUSTER+j]),
                .o_req_instr_valid                      (w_core_req_instr_valid                         [i*CORES_PER_CLUSTER+j]),
                .o_req_instr_priv                       (w_core_req_instr_priv                          [i*CORES_PER_CLUSTER+j]),
                .o_resp_instr_ready                     (w_core_resp_instr_ready                        [i*CORES_PER_CLUSTER+j]),
                .i_resp_instr                           (w_core_resp_instr                              [i*CORES_PER_CLUSTER+j]),
                .i_resp_instr_thrd_id                   (w_core_resp_instr_thrd_id                      [i*CORES_PER_CLUSTER+j]),
                .i_resp_instr_valid                     (w_core_resp_instr_valid                        [i*CORES_PER_CLUSTER+j]),
                .i_req_data_ready                       (w_core_req_data_ready                          [i*CORES_PER_CLUSTER+j]),
                .o_req_data_addr                        (w_core_req_data_addr                           [i*CORES_PER_CLUSTER+j]),
                .o_req_data_thrd_id                     (w_core_req_data_thrd_id                        [i*CORES_PER_CLUSTER+j]),
                .o_req_data_priv                        (w_core_req_data_priv                           [i*CORES_PER_CLUSTER+j]),
                .o_req_data_rw                          (w_core_req_data_rw                             [i*CORES_PER_CLUSTER+j]),
                .o_req_data_lq                          (w_core_req_data_lq                             [i*CORES_PER_CLUSTER+j]),
                .o_req_data_sc                          (w_core_req_data_sc                             [i*CORES_PER_CLUSTER+j]),
                .o_req_data_wstrb                       (w_core_req_data_wstrb                          [i*CORES_PER_CLUSTER+j]),
                .o_req_data_wdata                       (w_core_req_data_wdata                          [i*CORES_PER_CLUSTER+j]),
                .o_req_data_valid                       (w_core_req_data_valid                          [i*CORES_PER_CLUSTER+j]),
                .o_resp_data_ready                      (w_core_resp_data_ready                         [i*CORES_PER_CLUSTER+j]),
                .i_resp_data_rdata                      (w_core_resp_data_rdata                         [i*CORES_PER_CLUSTER+j]),
                .i_resp_data_sc_ok                      (w_core_resp_data_sc_ok                         [i*CORES_PER_CLUSTER+j]),
                .i_resp_data_thrd_id                    (w_core_resp_data_thrd_id                       [i*CORES_PER_CLUSTER+j]),
                .i_resp_data_valid                      (w_core_resp_data_valid                         [i*CORES_PER_CLUSTER+j]),
                .i_page_msg_instr_valid                 (r_core_page_msg_instr_valid                    [i*CORES_PER_CLUSTER+j]),
                .i_page_msg_instr                       (r_core_page_msg_instr                          [i*CORES_PER_CLUSTER+j]),
                .o_page_msg_instr_ready                 (w_core_page_msg_instr_ready                    [i*CORES_PER_CLUSTER+j]),
                .i_page_msg_data_valid                  (r_core_page_msg_data_valid                     [i*CORES_PER_CLUSTER+j]),
                .i_page_msg_data                        (r_core_page_msg_data                           [i*CORES_PER_CLUSTER+j]),
                .o_page_msg_data_ready                  (w_core_page_msg_data_ready                     [i*CORES_PER_CLUSTER+j]),
                .o_page_msg_valid                       (w_core_page_msg_valid                          [i*CORES_PER_CLUSTER+j]),
                .o_page_msg                             (w_core_page_msg                                [i*CORES_PER_CLUSTER+j]),
                .i_page_msg_ready                       (w_core_page_msg_ready                          [i*CORES_PER_CLUSTER+j])
            );

            for (genvar t = 0; t < NUM_HW_THRDS; t++) begin : gen_timers
                logic w_timer_req_valid;
                logic w_timer_req_we;
                logic [VIR_ADDR_W-1:0] w_timer_req_addr;
                logic [XLEN-1:0]       w_timer_req_wdata;
                logic [XLEN/8-1:0]     w_timer_req_wstrb;
                logic        w_timer_resp_valid;
                logic [31:0] w_timer_resp_rdata;

                assign w_timer_req_valid = w_core_req_data_valid[i*CORES_PER_CLUSTER+j] && 
                                           is_timer_mmio_addr(w_core_req_data_addr[i*CORES_PER_CLUSTER+j], w_core_req_data_priv[i*CORES_PER_CLUSTER+j]) &&
                                           (w_core_req_data_thrd_id[i*CORES_PER_CLUSTER+j] == t);
                
                assign w_timer_req_we    = w_core_req_data_rw[i*CORES_PER_CLUSTER+j];
                assign w_timer_req_addr  = w_core_req_data_addr[i*CORES_PER_CLUSTER+j];
                assign w_timer_req_wdata = w_core_req_data_wdata[i*CORES_PER_CLUSTER+j];
                assign w_timer_req_wstrb = w_core_req_data_wstrb[i*CORES_PER_CLUSTER+j];

                timer timer_inst (
                    .clk_i       (w_core_clk[i*CORES_PER_CLUSTER+j]),
                    .rst_ni      (w_core_rst_n[i*CORES_PER_CLUSTER+j]),
                    .req_valid_i (w_timer_req_valid),
                    .req_addr_i  (w_timer_req_addr),
                    .req_we_i    (w_timer_req_we),
                    .req_wstrb_i (w_timer_req_wstrb),
                    .req_wdata_i (w_timer_req_wdata),
                    .resp_valid_o(w_timer_resp_valid),
                    .resp_rdata_o(w_timer_resp_rdata),
                    .irq_timer_o (w_core_irq_timer_vec[i*CORES_PER_CLUSTER+j][t])
                );

                assign w_core_timer_req_valid[i*CORES_PER_CLUSTER+j][t]  = w_timer_req_valid;
                assign w_core_timer_resp_valid[i*CORES_PER_CLUSTER+j][t] = w_timer_resp_valid;
                assign w_core_timer_resp_rdata[i*CORES_PER_CLUSTER+j][t] =
                    {{(XLEN-32){1'b0}}, w_timer_resp_rdata};
            end

            end
            memory #(.REGION_ID(i)) memory_u (
                .i_clk                                  (w_memory_clk                                   [i]),
                .i_rst_n                                (w_memory_rst_n                                 [i]),
                .i_req_we                               (w_memory_req_we                                [i]),
                .i_req_thrd                             (w_memory_req_thrd                              [i]),
                .i_req_is_lr                            (w_memory_req_is_lr                             [i]),
                .i_req_is_sc                            (w_memory_req_is_sc                             [i]),
                .i_req_addr                             (w_memory_req_addr                              [i]),
                .i_req_wstrb                            (w_memory_req_wstrb                             [i]),
                .i_req_wdata                            (w_memory_req_wdata                             [i]),
                .i_req_valid                            (w_memory_req_valid                             [i]),
                .i_req_priv                             (w_memory_req_priv                              [i]),
                .o_req_ready                            (w_memory_req_ready                             [i]),
                .o_resp_thrd                            (w_memory_resp_thrd                             [i]),
                .o_resp_sc_succ                         (w_memory_resp_sc_succ                          [i]),
                .o_resp_rdata                           (w_memory_resp_rdata                            [i]),
                .o_resp_valid                           (w_memory_resp_valid                            [i]),
                .i_resp_ready                           (w_memory_resp_ready                            [i]),
                .i_page_msg_valid                       (w_memory_page_msg_valid                        [i]),
                .o_page_msg_ready                       (w_memory_page_msg_ready                        [i]),
                .i_page_msg                             (w_memory_page_msg                              [i]),
                .i_page_msg_ready                       (r_memory_o_page_msg_ready                      [i]),
                .o_page_msg_valid                       (w_memory_o_page_msg_valid                      [i]),
                .o_page_msg                             (w_memory_o_page_msg                            [i]),
                .o_page_req_we                          (w_memory_page_req_we                           [i]),
                .o_page_req_valid                       (w_memory_page_req_valid                        [i]),
                .o_page_req_thrd                        (w_memory_page_req_thrd                         [i]),
                .i_page_req_ready                       (w_memory_page_req_ready                        [i]),
                .o_page_req_addr                        (w_memory_page_req_addr                         [i]),
                .o_page_req_wdata                       (w_memory_page_req_wdata                        [i]),
                .i_page_resp_addr                       (w_memory_page_resp_addr                        [i]),
                .i_page_resp_we                         (w_memory_page_resp_we                          [i]),
                .i_page_resp_wdata                      (w_memory_page_resp_wdata                       [i]),
                .i_page_resp_valid                      (w_memory_page_resp_valid                       [i]),
                .o_page_resp_ready                      (w_memory_page_resp_ready                       [i])
            );
            if (topology_pkg::SYS_CORES_PER_CLUSTER > 0) begin : gen_sys_core_enabled
            sys_core sys_core_u (
                .i_clk                                  (i_clk),
                .i_rst_n                                (rst_accel_n),
                .i_mmio_req_valid                       (w_sys_mmio_req_valid                          [i]),
                .o_mmio_req_ready                       (w_sys_mmio_req_ready                          [i]),
                .i_mmio_req_addr                        (w_sys_mmio_req_addr                           [i]),
                .i_mmio_req_wdata                       (w_sys_mmio_req_wdata                          [i]),
                .i_mmio_req_wmask                       (w_sys_mmio_req_wmask                          [i]),
                .o_mmio_resp_valid                      (w_sys_mmio_resp_valid                         [i]),
                .o_mmio_resp_rdata                      (w_sys_mmio_resp_rdata                         [i]),
                .i_mmio_resp_ready                      (w_sys_mmio_resp_ready                         [i]),
                .i_host_thrd                            (r_sys_host_thrd                               [i]),
                .o_intr                                 (w_sys_intr                                    [i]),
                .o_intr_thrd                            (w_sys_intr_thrd                               [i]),
                .o_req_we                               (w_sys_req_we                                  [i]),
                .o_req_thrd                             (w_sys_req_thrd                                [i]),
                .o_req_is_lr                            (w_sys_req_is_lr                               [i]),
                .o_req_is_sc                            (w_sys_req_is_sc                               [i]),
                .o_req_addr                             (w_sys_req_addr                                [i]),
                .o_req_wstrb                            (w_sys_req_wstrb                               [i]),
                .o_req_wdata                            (w_sys_req_wdata                               [i]),
                .o_req_valid                            (w_sys_req_valid                               [i]),
                .i_req_ready                            (w_sys_req_ready                               [i]),
                .i_resp_thrd                            (w_sys_resp_thrd                               [i]),
                .i_resp_sc_succ                         (w_sys_resp_sc_succ                            [i]),
                .i_resp_rdata                           (w_sys_resp_rdata                              [i]),
                .i_resp_valid                           (w_sys_resp_valid                              [i]),
                .o_resp_ready                           (w_sys_resp_ready                              [i])
            );
            end else begin : gen_sys_core_disabled
                assign w_sys_mmio_req_ready[i] = 1'b0;
                assign w_sys_mmio_resp_valid[i] = 1'b0;
                assign w_sys_mmio_resp_rdata[i] = '0;
                assign w_sys_intr[i] = 1'b0;
                assign w_sys_intr_thrd[i] = '0;
            end
        end
    endgenerate

    uart_mmio #(
        .BASE_ADDR                                      (UART_BASE_ADDR),
        .RX_DEPTH                                       (1024),
        .TX_DEPTH                                       (1024)
    ) uart_mmio_inst (
        .i_clk                                          (w_uart_mmio_clk),
        .i_rst_n                                        (w_uart_mmio_rst_n),
        .i_req_we                                       (w_uart_mmio_req_we),
        .i_req_thrd                                     (w_uart_mmio_req_thrd),
        .i_req_is_lr                                    (w_uart_mmio_req_is_lr),
        .i_req_is_sc                                    (w_uart_mmio_req_is_sc),
        .i_req_addr                                     (w_uart_mmio_req_addr),
        .i_req_wstrb                                    (w_uart_mmio_req_wstrb),
        .i_req_wdata                                    (w_uart_mmio_req_wdata),
        .i_req_valid                                    (w_uart_mmio_req_valid),
        .i_req_priv                                     (w_uart_mmio_req_priv),
        .o_req_ready                                    (w_uart_mmio_req_ready),
        .o_resp_thrd                                    (w_uart_mmio_resp_thrd),
        .o_resp_sc_succ                                 (w_uart_mmio_resp_sc_succ),
        .o_resp_rdata                                   (w_uart_mmio_resp_rdata),
        .o_resp_valid                                   (w_uart_mmio_resp_valid),
        .i_resp_ready                                   (w_uart_mmio_resp_ready),
        .i_rx                                           (w_uart_mmio_rx),
        .o_tx                                           (w_uart_mmio_tx)
    );
    /* ---*/

    /* topology */

    logic                                r_mem_req_instr_valid  [NUM_CORES-1:0][3:0];
    logic                                r_mem_req_instr_ready  [NUM_CORES-1:0][3:0];
    logic [VIR_ADDR_W-1:0]               r_mem_req_instr_addr   [NUM_CORES-1:0][3:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]     r_mem_req_instr_thrd_id[NUM_CORES-1:0][3:0];
    logic [1:0]                          r_mem_req_instr_priv   [NUM_CORES-1:0][3:0];
    
    logic                                r_mem_resp_instr_valid [NUM_CORES-1:0][3:0];
    logic                                r_mem_resp_instr_ready [NUM_CORES-1:0][3:0];
    logic [XLEN-1:0]                     r_mem_resp_instr_rdata [NUM_CORES-1:0][3:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]     r_mem_resp_instr_thrd_id[NUM_CORES-1:0][3:0];

    logic                                r_mem_req_data_valid   [NUM_CORES-1:0][3:0];
    logic                                r_mem_req_data_ready   [NUM_CORES-1:0][3:0];
    logic [VIR_ADDR_W-1:0]               r_mem_req_data_addr    [NUM_CORES-1:0][3:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]     r_mem_req_data_thrd_id [NUM_CORES-1:0][3:0];
    logic [1:0]                          r_mem_req_data_priv    [NUM_CORES-1:0][3:0];
    logic                                r_mem_req_data_rw      [NUM_CORES-1:0][3:0];
    logic                                r_mem_req_data_lq      [NUM_CORES-1:0][3:0];
    logic                                r_mem_req_data_sc      [NUM_CORES-1:0][3:0];
    logic [XLEN/8-1:0]                   r_mem_req_data_wstrb   [NUM_CORES-1:0][3:0];
    logic [XLEN-1:0]                     r_mem_req_data_wdata   [NUM_CORES-1:0][3:0];
    
    logic                                r_mem_resp_data_valid  [NUM_CORES-1:0][3:0];
    logic                                r_mem_resp_data_ready  [NUM_CORES-1:0][3:0];
    logic [XLEN-1:0]                     r_mem_resp_data_rdata  [NUM_CORES-1:0][3:0];
    logic                                r_mem_resp_data_sc_ok  [NUM_CORES-1:0][3:0];
    logic [$clog2(NUM_HW_THRDS)-1:0]     r_mem_resp_data_thrd_id[NUM_CORES-1:0][3:0];

    /* Router-side signals.  The r_mem_* arrays above are the memory-side
     * signals; one-entry elastic registers between them break the long
     * core/router/memory combinational scheduling chain. */
    logic w_rtr_req_i_valid[NUM_CORES-1:0][3:0], w_rtr_req_i_ready[NUM_CORES-1:0][3:0];
    logic [VIR_ADDR_W-1:0] w_rtr_req_i_addr[NUM_CORES-1:0][3:0];
    logic [CORE_THRD_W-1:0] w_rtr_req_i_thrd[NUM_CORES-1:0][3:0];
    logic [1:0] w_rtr_req_i_priv[NUM_CORES-1:0][3:0];
    logic w_rtr_rsp_i_valid[NUM_CORES-1:0][3:0], w_rtr_rsp_i_ready[NUM_CORES-1:0][3:0];
    logic [XLEN-1:0] w_rtr_rsp_i_data[NUM_CORES-1:0][3:0];
    logic [CORE_THRD_W-1:0] w_rtr_rsp_i_thrd[NUM_CORES-1:0][3:0];
    logic w_rtr_req_d_valid[NUM_CORES-1:0][3:0], w_rtr_req_d_ready[NUM_CORES-1:0][3:0];
    logic [VIR_ADDR_W-1:0] w_rtr_req_d_addr[NUM_CORES-1:0][3:0];
    logic [CORE_THRD_W-1:0] w_rtr_req_d_thrd[NUM_CORES-1:0][3:0];
    logic [1:0] w_rtr_req_d_priv[NUM_CORES-1:0][3:0];
    logic w_rtr_req_d_rw[NUM_CORES-1:0][3:0], w_rtr_req_d_lq[NUM_CORES-1:0][3:0];
    logic w_rtr_req_d_sc[NUM_CORES-1:0][3:0];
    logic [XLEN/8-1:0] w_rtr_req_d_wstrb[NUM_CORES-1:0][3:0];
    logic [XLEN-1:0] w_rtr_req_d_wdata[NUM_CORES-1:0][3:0];
    logic w_rtr_rsp_d_valid[NUM_CORES-1:0][3:0], w_rtr_rsp_d_ready[NUM_CORES-1:0][3:0];
    logic [XLEN-1:0] w_rtr_rsp_d_data[NUM_CORES-1:0][3:0];
    logic w_rtr_rsp_d_sc_ok[NUM_CORES-1:0][3:0];
    logic [CORE_THRD_W-1:0] w_rtr_rsp_d_thrd[NUM_CORES-1:0][3:0];

    function automatic logic [THRD_W-1:0] memory_thread_id(
        input int core_id,
        input logic [CORE_THRD_W-1:0] local_thrd_id
    );
        int core_local_id;
        begin
            core_local_id = core_id % CORES_PER_CLUSTER;
            memory_thread_id = THRD_W'(core_local_id * NUM_HW_THRDS) + THRD_W'(local_thrd_id);
        end
    endfunction

    function automatic logic [CORE_THRD_W-1:0] core_thread_id(
        input logic [THRD_W-1:0] memory_thrd_id
    );
        begin
            core_thread_id = CORE_THRD_W'(memory_thrd_id % NUM_HW_THRDS);
        end
    endfunction

    generate
	    for (genvar c = 0; c < NUM_CORES; c++) begin : gen_routers
	        localparam int CLUSTER_ID = c / CORES_PER_CLUSTER;
	        localparam int C_X = get_c_x(CLUSTER_ID);
	        localparam int C_Y = get_c_y(CLUSTER_ID);
            
            router #(
                .C_X(C_X),
                .C_Y(C_Y)
            ) router_u (
                .i_clk(i_clk),
                .i_rst_n(rst_fabric_n),
                .i_req_instr_valid(w_core_req_instr_valid[c]),
                .o_req_instr_ready(w_core_req_instr_ready[c]),
                .i_req_instr_addr(w_core_req_instr_addr[c]),
                .i_req_instr_thrd_id(w_core_req_instr_thrd_id[c]),
                .i_req_instr_priv(w_core_req_instr_priv[c]),
                
                .o_resp_instr_valid(w_core_resp_instr_valid[c]),
                .i_resp_instr_ready(w_core_resp_instr_ready[c]),
                .o_resp_instr(w_core_resp_instr[c]),
                .o_resp_instr_thrd_id(w_core_resp_instr_thrd_id[c]),

                .i_req_data_valid(w_core_req_data_valid[c] &&
	                                  !(w_core_req_data_priv[c] == 2'b11 &&
                                    ((w_core_req_data_addr[c] >= UART_BASE_ADDR &&
                                      w_core_req_data_addr[c] <= UART_END_ADDR) ||
	                                     is_ipi_addr(w_core_req_data_addr[c]) ||
                                         is_sys_mmio_addr(w_core_req_data_addr[c], w_core_req_data_priv[c]) ||
                                         is_timer_mmio_addr(w_core_req_data_addr[c], w_core_req_data_priv[c]) ||
                                         is_dummy_oob_data_addr(w_core_req_data_addr[c], w_core_req_data_priv[c])))),
                .o_req_data_ready(w_router_req_data_ready[c]),
                .i_req_data_addr(w_core_req_data_addr[c]),
                .i_req_data_thrd_id(w_core_req_data_thrd_id[c]),
                .i_req_data_priv(w_core_req_data_priv[c]),
                .i_req_data_rw(w_core_req_data_rw[c]),
                .i_req_data_lq(w_core_req_data_lq[c]),
                .i_req_data_sc(w_core_req_data_sc[c]),
                .i_req_data_wstrb(w_core_req_data_wstrb[c]),
                .i_req_data_wdata(w_core_req_data_wdata[c]),
                
                .o_resp_data_valid(w_router_resp_data_valid[c]),
                .i_resp_data_ready(w_core_resp_data_ready[c]),
                .o_resp_data_rdata(w_router_resp_data_rdata[c]),
                .o_resp_data_sc_ok(w_router_resp_data_sc_ok[c]),
                .o_resp_data_thrd_id(w_router_resp_data_thrd_id[c]),

                .o_mem_req_instr_valid(w_rtr_req_i_valid[c]),
                .i_mem_req_instr_ready(w_rtr_req_i_ready[c]),
                .o_mem_req_instr_addr(w_rtr_req_i_addr[c]),
                .o_mem_req_instr_thrd_id(w_rtr_req_i_thrd[c]),
                .o_mem_req_instr_priv(w_rtr_req_i_priv[c]),
                
                .i_mem_resp_instr_valid(w_rtr_rsp_i_valid[c]),
                .o_mem_resp_instr_ready(w_rtr_rsp_i_ready[c]),
                .i_mem_resp_instr_rdata(w_rtr_rsp_i_data[c]),
                .i_mem_resp_instr_thrd_id(w_rtr_rsp_i_thrd[c]),

                .o_mem_req_data_valid(w_rtr_req_d_valid[c]),
                .i_mem_req_data_ready(w_rtr_req_d_ready[c]),
                .o_mem_req_data_addr(w_rtr_req_d_addr[c]),
                .o_mem_req_data_thrd_id(w_rtr_req_d_thrd[c]),
                .o_mem_req_data_priv(w_rtr_req_d_priv[c]),
                .o_mem_req_data_rw(w_rtr_req_d_rw[c]),
                .o_mem_req_data_lq(w_rtr_req_d_lq[c]),
                .o_mem_req_data_sc(w_rtr_req_d_sc[c]),
                .o_mem_req_data_wstrb(w_rtr_req_d_wstrb[c]),
                .o_mem_req_data_wdata(w_rtr_req_d_wdata[c]),
                
                .i_mem_resp_data_valid(w_rtr_rsp_d_valid[c]),
                .o_mem_resp_data_ready(w_rtr_rsp_d_ready[c]),
                .i_mem_resp_data_rdata(w_rtr_rsp_d_data[c]),
                .i_mem_resp_data_sc_ok(w_rtr_rsp_d_sc_ok[c]),
                .i_mem_resp_data_thrd_id(w_rtr_rsp_d_thrd[c])
            );

        end
    endgenerate

    generate
        // Keep requests combinational to minimize target latency.  Registering
        // responses alone breaks the router/memory ready-valid cycle and was
        // the fastest loop-free arrangement in the simulator benchmark.
        for (genvar bc = 0; bc < NUM_CORES; bc++) begin : gen_mem_boundary_core
            for (genvar bd = 0; bd < 4; bd++) begin : gen_mem_boundary_dir
                assign r_mem_req_instr_valid[bc][bd] = w_rtr_req_i_valid[bc][bd];
                assign w_rtr_req_i_ready[bc][bd] = r_mem_req_instr_ready[bc][bd];
                assign r_mem_req_instr_addr[bc][bd] = w_rtr_req_i_addr[bc][bd];
                assign r_mem_req_instr_thrd_id[bc][bd] = w_rtr_req_i_thrd[bc][bd];
                assign r_mem_req_instr_priv[bc][bd] = w_rtr_req_i_priv[bc][bd];
                assign r_mem_req_data_valid[bc][bd] = w_rtr_req_d_valid[bc][bd];
                assign w_rtr_req_d_ready[bc][bd] = r_mem_req_data_ready[bc][bd];
                assign r_mem_req_data_addr[bc][bd] = w_rtr_req_d_addr[bc][bd];
                assign r_mem_req_data_thrd_id[bc][bd] = w_rtr_req_d_thrd[bc][bd];
                assign r_mem_req_data_priv[bc][bd] = w_rtr_req_d_priv[bc][bd];
                assign r_mem_req_data_rw[bc][bd] = w_rtr_req_d_rw[bc][bd];
                assign r_mem_req_data_lq[bc][bd] = w_rtr_req_d_lq[bc][bd];
                assign r_mem_req_data_sc[bc][bd] = w_rtr_req_d_sc[bc][bd];
                assign r_mem_req_data_wstrb[bc][bd] = w_rtr_req_d_wstrb[bc][bd];
                assign r_mem_req_data_wdata[bc][bd] = w_rtr_req_d_wdata[bc][bd];
                assign r_mem_resp_instr_ready[bc][bd] = !w_rtr_rsp_i_valid[bc][bd] ||
                                                        w_rtr_rsp_i_ready[bc][bd];
                assign r_mem_resp_data_ready[bc][bd] = !w_rtr_rsp_d_valid[bc][bd] ||
                                                       w_rtr_rsp_d_ready[bc][bd];

                always_ff @(posedge i_clk or negedge rst_fabric_n) begin
                    if (!rst_fabric_n) begin
                        w_rtr_rsp_i_valid[bc][bd] <= 1'b0;
                        w_rtr_rsp_d_valid[bc][bd] <= 1'b0;
                    end else begin
                        if (r_mem_resp_instr_ready[bc][bd]) begin
                            w_rtr_rsp_i_valid[bc][bd] <= r_mem_resp_instr_valid[bc][bd];
                            if (r_mem_resp_instr_valid[bc][bd]) begin
                                w_rtr_rsp_i_data[bc][bd] <= r_mem_resp_instr_rdata[bc][bd];
                                w_rtr_rsp_i_thrd[bc][bd] <= r_mem_resp_instr_thrd_id[bc][bd];
                            end
                        end
                        if (r_mem_resp_data_ready[bc][bd]) begin
                            w_rtr_rsp_d_valid[bc][bd] <= r_mem_resp_data_valid[bc][bd];
                            if (r_mem_resp_data_valid[bc][bd]) begin
                                w_rtr_rsp_d_data[bc][bd] <= r_mem_resp_data_rdata[bc][bd];
                                w_rtr_rsp_d_sc_ok[bc][bd] <= r_mem_resp_data_sc_ok[bc][bd];
                                w_rtr_rsp_d_thrd[bc][bd] <= r_mem_resp_data_thrd_id[bc][bd];
                            end
                        end
                    end
                end
            end
        end
    endgenerate

    always_comb begin
        // default all memory ports to unused
        for (int m = 0; m < NUM_MEM; m++) begin
            for (int p = 0; p < NUM_RW_PORTS; p++) begin
                w_memory_req_valid[m][p] = 1'b0;
                w_memory_req_addr[m][p]  = '0;
                w_memory_req_thrd[m][p]  = '0;
                w_memory_req_priv[m][p]  = 2'b11;
                w_memory_req_we[m][p]    = 1'b0;
                w_memory_req_is_lr[m][p] = 1'b0;
                w_memory_req_is_sc[m][p] = 1'b0;
                w_memory_req_wstrb[m][p] = '0;
                w_memory_req_wdata[m][p] = '0;
                
                w_memory_resp_ready[m][p] = 1'b0;

                w_memory_page_msg_valid[m][p]   = 1'b0;
                w_memory_page_msg[m][p]         = '0;
                w_memory_o_page_msg_ready[m][p] = 1'b0;
            end
        end
        // default all router mem interfaces to unused
        for (int c = 0; c < NUM_CORES; c++) begin
            w_core_page_msg_ready[c] = 1'b1;
            w_core_page_msg_instr_valid[c] = 1'b0;
            w_core_page_msg_instr[c]       = '0;
            w_core_page_msg_data_valid[c]  = 1'b0;
            w_core_page_msg_data[c]        = '0;
            for (int i = 0; i < 4; i++) begin
                r_mem_req_instr_ready[c][i] = 1'b0;
                r_mem_resp_instr_valid[c][i] = 1'b0;
                r_mem_resp_instr_rdata[c][i] = '0;
                r_mem_resp_instr_thrd_id[c][i] = '0;
                
                r_mem_req_data_ready[c][i] = 1'b0;
                r_mem_resp_data_valid[c][i] = 1'b0;
                r_mem_resp_data_rdata[c][i] = '0;
                r_mem_resp_data_sc_ok[c][i] = 1'b0;
                r_mem_resp_data_thrd_id[c][i] = '0;
            end
        end
        for (int cl = 0; cl < NUM_CLUSTER; cl++) begin
            w_sys_mmio_req_valid[cl] = 1'b0;
            w_sys_mmio_req_addr[cl]  = '0;
            w_sys_mmio_req_wdata[cl] = '0;
            w_sys_mmio_req_wmask[cl] = '0;
            w_sys_mmio_resp_ready[cl] = 1'b0;
            w_sys_cmd_host_thrd[cl] = r_sys_host_thrd[cl];
            w_sys_cmd_host_vtid[cl] = r_sys_host_vtid[cl];
            w_sys_cmd_host_valid[cl] = 1'b0;
            for (int sp = 0; sp < NUM_SYS_PORTS; sp++) begin
                w_sys_req_ready[cl][sp] = 1'b0;
                w_sys_resp_thrd[cl][sp] = '0;
                w_sys_resp_sc_succ[cl][sp] = 1'b0;
                w_sys_resp_rdata[cl][sp] = '0;
                w_sys_resp_valid[cl][sp] = 1'b0;
            end
        end
        w_sys_mmio_grant = '0;
        for (int cl = 0; cl < NUM_CLUSTER; cl++) begin
            for (int k = 0; k < CORES_PER_CLUSTER; k++) begin
                int c = cl * CORES_PER_CLUSTER + k;
                if (w_core_req_data_valid[c] &&
                    is_sys_mmio_addr(w_core_req_data_addr[c], w_core_req_data_priv[c]) &&
                    !w_sys_mmio_req_valid[cl]) begin
                    w_sys_mmio_grant[c] = 1'b1;
                    w_sys_mmio_req_valid[cl] = 1'b1;
                    w_sys_mmio_req_addr[cl]  = w_core_req_data_addr[c];
                    w_sys_mmio_req_wdata[cl] = w_core_req_data_wdata[c];
                    w_sys_mmio_req_wmask[cl] = w_core_req_data_wstrb[c];
                    w_sys_cmd_host_thrd[cl] = memory_thread_id(c, w_core_req_data_thrd_id[c]);
                    w_sys_cmd_host_vtid[cl] = r_core_active_vtid[c][w_core_req_data_thrd_id[c]];
                    w_sys_cmd_host_valid[cl] = w_core_req_data_rw[c] &&
                                               (w_core_req_data_wstrb[c] != '0) &&
                                               (w_core_req_data_addr[c][7:0] == 8'h08) &&
                                               (w_sys_mmio_req_wdata[cl][31:24] == 8'h03) &&
                                               w_sys_mmio_req_ready[cl];
                end
                if (r_sys_resp_core[cl] == $bits(r_sys_resp_core[cl])'(k)) begin
                    w_sys_mmio_resp_ready[cl] = w_core_resp_data_ready[c];
                end
            end
        end
        
	        for (int c = 0; c < NUM_CORES; c++) begin
	            int CLUSTER_ID = c / CORES_PER_CLUSTER;
	            int CORE_LOCAL_ID = c % CORES_PER_CLUSTER;
	            int PORT_BASE = CORE_LOCAL_ID * 4 * 2;
	            int P_SI = PORT_BASE + 0;
	            int P_SD = PORT_BASE + 1;
	            int P_WI = PORT_BASE + 2;
	            int P_WD = PORT_BASE + 3;
	            int P_NI = PORT_BASE + 4;
	            int P_ND = PORT_BASE + 5;
	            int P_EI = PORT_BASE + 6;
	            int P_ED = PORT_BASE + 7;
	            int C_X = get_c_x(CLUSTER_ID);
	            int C_Y = get_c_y(CLUSTER_ID);
	            int M_N = (C_Y > 0)          ? get_m_id(C_X, C_Y - 1) : -1;
	            int M_E = (C_X < GRID_X - 1) ? get_m_id(C_X + 1, C_Y) : -1;
	            int M_S = (C_Y < GRID_Y - 1) ? get_m_id(C_X, C_Y + 1) : -1;
	            int M_W = (C_X > 0)          ? get_m_id(C_X - 1, C_Y) : -1;

	            if ((C_X % 2) == 0) begin
	                if (M_E != -1) begin
	                    w_memory_page_msg_valid[M_E][P_ED] = w_core_page_msg_valid[c];
	                    w_memory_page_msg[M_E][P_ED]       = w_core_page_msg[c];
	                    w_core_page_msg_ready[c]           = w_memory_page_msg_ready[M_E][P_ED];
	                end
	            end else begin
	                if (M_W != -1) begin
	                    w_memory_page_msg_valid[M_W][P_WD] = w_core_page_msg_valid[c];
	                    w_memory_page_msg[M_W][P_WD]       = w_core_page_msg[c];
	                    w_core_page_msg_ready[c]           = w_memory_page_msg_ready[M_W][P_WD];
	                end
	            end

	            // Map C's North to M_N's South
	            if (M_N != -1) begin
	                w_memory_req_valid[M_N][P_NI] = r_mem_req_instr_valid[c][0];
	                w_memory_req_addr[M_N][P_NI]  = memory_req_addr(r_mem_req_instr_addr[c][0], r_mem_req_instr_priv[c][0]);
	                w_memory_req_thrd[M_N][P_NI]  = memory_thread_id(c, r_mem_req_instr_thrd_id[c][0]);
	                w_memory_req_priv[M_N][P_NI]  = r_mem_req_instr_priv[c][0];
	                r_mem_req_instr_ready[c][0] = w_memory_req_ready[M_N][P_NI];
	                
	                r_mem_resp_instr_valid[c][0] = w_memory_resp_valid[M_N][P_NI];
	                w_memory_resp_ready[M_N][P_NI]  = r_mem_resp_instr_ready[c][0];
	                r_mem_resp_instr_rdata[c][0] = w_memory_resp_rdata[M_N][P_NI];
	                r_mem_resp_instr_thrd_id[c][0] = core_thread_id(w_memory_resp_thrd[M_N][P_NI]);
	                w_memory_o_page_msg_ready[M_N][P_NI] = w_core_page_msg_instr_ready[c];
	                if (w_memory_o_page_msg_valid[M_N][P_NI]) begin
	                    w_core_page_msg_instr_valid[c] = 1'b1;
	                    w_core_page_msg_instr[c]       = w_memory_o_page_msg[M_N][P_NI];
	                end

	                w_memory_req_valid[M_N][P_ND] = r_mem_req_data_valid[c][0];
	                w_memory_req_addr[M_N][P_ND]  = memory_req_addr(r_mem_req_data_addr[c][0], r_mem_req_data_priv[c][0]);
	                w_memory_req_thrd[M_N][P_ND]  = memory_thread_id(c, r_mem_req_data_thrd_id[c][0]);
	                w_memory_req_priv[M_N][P_ND]  = r_mem_req_data_priv[c][0];
	                w_memory_req_we[M_N][P_ND]    = r_mem_req_data_rw[c][0];
	                w_memory_req_is_lr[M_N][P_ND] = r_mem_req_data_lq[c][0];
	                w_memory_req_is_sc[M_N][P_ND] = r_mem_req_data_sc[c][0];
	                w_memory_req_wstrb[M_N][P_ND] = r_mem_req_data_wstrb[c][0];
	                w_memory_req_wdata[M_N][P_ND] = r_mem_req_data_wdata[c][0];
	                r_mem_req_data_ready[c][0] = w_memory_req_ready[M_N][P_ND];
	                
	                r_mem_resp_data_valid[c][0] = w_memory_resp_valid[M_N][P_ND];
	                w_memory_resp_ready[M_N][P_ND]  = r_mem_resp_data_ready[c][0];
	                r_mem_resp_data_rdata[c][0] = w_memory_resp_rdata[M_N][P_ND];
	                r_mem_resp_data_sc_ok[c][0] = w_memory_resp_sc_succ[M_N][P_ND];
	                r_mem_resp_data_thrd_id[c][0] = core_thread_id(w_memory_resp_thrd[M_N][P_ND]);
	                w_memory_o_page_msg_ready[M_N][P_ND] = w_core_page_msg_data_ready[c];
	                if (w_memory_o_page_msg_valid[M_N][P_ND]) begin
	                    w_core_page_msg_data_valid[c] = 1'b1;
	                    w_core_page_msg_data[c]       = w_memory_o_page_msg[M_N][P_ND];
	                end
	            end
	            
	            // Map C's East to M_E's West
	            if (M_E != -1) begin
	                w_memory_req_valid[M_E][P_EI] = r_mem_req_instr_valid[c][1];
	                w_memory_req_addr[M_E][P_EI]  = memory_req_addr(r_mem_req_instr_addr[c][1], r_mem_req_instr_priv[c][1]);
	                w_memory_req_thrd[M_E][P_EI]  = memory_thread_id(c, r_mem_req_instr_thrd_id[c][1]);
	                w_memory_req_priv[M_E][P_EI]  = r_mem_req_instr_priv[c][1];
	                r_mem_req_instr_ready[c][1] = w_memory_req_ready[M_E][P_EI];
	                
	                r_mem_resp_instr_valid[c][1] = w_memory_resp_valid[M_E][P_EI];
	                w_memory_resp_ready[M_E][P_EI]  = r_mem_resp_instr_ready[c][1];
	                r_mem_resp_instr_rdata[c][1] = w_memory_resp_rdata[M_E][P_EI];
	                r_mem_resp_instr_thrd_id[c][1] = core_thread_id(w_memory_resp_thrd[M_E][P_EI]);
	                w_memory_o_page_msg_ready[M_E][P_EI] = w_core_page_msg_instr_ready[c];
	                if (w_memory_o_page_msg_valid[M_E][P_EI]) begin
	                    w_core_page_msg_instr_valid[c] = 1'b1;
	                    w_core_page_msg_instr[c]       = w_memory_o_page_msg[M_E][P_EI];
	                end

	                w_memory_req_valid[M_E][P_ED] = r_mem_req_data_valid[c][1];
	                w_memory_req_addr[M_E][P_ED]  = memory_req_addr(r_mem_req_data_addr[c][1], r_mem_req_data_priv[c][1]);
	                w_memory_req_thrd[M_E][P_ED]  = memory_thread_id(c, r_mem_req_data_thrd_id[c][1]);
	                w_memory_req_priv[M_E][P_ED]  = r_mem_req_data_priv[c][1];
	                w_memory_req_we[M_E][P_ED]    = r_mem_req_data_rw[c][1];
	                w_memory_req_is_lr[M_E][P_ED] = r_mem_req_data_lq[c][1];
	                w_memory_req_is_sc[M_E][P_ED] = r_mem_req_data_sc[c][1];
	                w_memory_req_wstrb[M_E][P_ED] = r_mem_req_data_wstrb[c][1];
	                w_memory_req_wdata[M_E][P_ED] = r_mem_req_data_wdata[c][1];
	                r_mem_req_data_ready[c][1] = w_memory_req_ready[M_E][P_ED];
	                
	                r_mem_resp_data_valid[c][1] = w_memory_resp_valid[M_E][P_ED];
	                w_memory_resp_ready[M_E][P_ED]  = r_mem_resp_data_ready[c][1];
	                r_mem_resp_data_rdata[c][1] = w_memory_resp_rdata[M_E][P_ED];
	                r_mem_resp_data_sc_ok[c][1] = w_memory_resp_sc_succ[M_E][P_ED];
	                r_mem_resp_data_thrd_id[c][1] = core_thread_id(w_memory_resp_thrd[M_E][P_ED]);
	                w_memory_o_page_msg_ready[M_E][P_ED] = w_core_page_msg_data_ready[c];
	                if (w_memory_o_page_msg_valid[M_E][P_ED]) begin
	                    w_core_page_msg_data_valid[c] = 1'b1;
	                    w_core_page_msg_data[c]       = w_memory_o_page_msg[M_E][P_ED];
	                end

	            end
	            
	            // Map C's South to M_S's North
	            if (M_S != -1) begin
	                w_memory_req_valid[M_S][P_SI] = r_mem_req_instr_valid[c][2];
	                w_memory_req_addr[M_S][P_SI]  = memory_req_addr(r_mem_req_instr_addr[c][2], r_mem_req_instr_priv[c][2]);
	                w_memory_req_thrd[M_S][P_SI]  = memory_thread_id(c, r_mem_req_instr_thrd_id[c][2]);
	                w_memory_req_priv[M_S][P_SI]  = r_mem_req_instr_priv[c][2];
	                r_mem_req_instr_ready[c][2] = w_memory_req_ready[M_S][P_SI];
	                
	                r_mem_resp_instr_valid[c][2] = w_memory_resp_valid[M_S][P_SI];
	                w_memory_resp_ready[M_S][P_SI]  = r_mem_resp_instr_ready[c][2];
	                r_mem_resp_instr_rdata[c][2] = w_memory_resp_rdata[M_S][P_SI];
	                r_mem_resp_instr_thrd_id[c][2] = core_thread_id(w_memory_resp_thrd[M_S][P_SI]);
	                w_memory_o_page_msg_ready[M_S][P_SI] = w_core_page_msg_instr_ready[c];
	                if (w_memory_o_page_msg_valid[M_S][P_SI]) begin
	                    w_core_page_msg_instr_valid[c] = 1'b1;
	                    w_core_page_msg_instr[c]       = w_memory_o_page_msg[M_S][P_SI];
	                end

	                w_memory_req_valid[M_S][P_SD] = r_mem_req_data_valid[c][2];
	                w_memory_req_addr[M_S][P_SD]  = memory_req_addr(r_mem_req_data_addr[c][2], r_mem_req_data_priv[c][2]);
	                w_memory_req_thrd[M_S][P_SD]  = memory_thread_id(c, r_mem_req_data_thrd_id[c][2]);
	                w_memory_req_priv[M_S][P_SD]  = r_mem_req_data_priv[c][2];
	                w_memory_req_we[M_S][P_SD]    = r_mem_req_data_rw[c][2];
	                w_memory_req_is_lr[M_S][P_SD] = r_mem_req_data_lq[c][2];
	                w_memory_req_is_sc[M_S][P_SD] = r_mem_req_data_sc[c][2];
	                w_memory_req_wstrb[M_S][P_SD] = r_mem_req_data_wstrb[c][2];
	                w_memory_req_wdata[M_S][P_SD] = r_mem_req_data_wdata[c][2];
	                r_mem_req_data_ready[c][2] = w_memory_req_ready[M_S][P_SD];
	                
	                r_mem_resp_data_valid[c][2] = w_memory_resp_valid[M_S][P_SD];
	                w_memory_resp_ready[M_S][P_SD]  = r_mem_resp_data_ready[c][2];
	                r_mem_resp_data_rdata[c][2] = w_memory_resp_rdata[M_S][P_SD];
	                r_mem_resp_data_sc_ok[c][2] = w_memory_resp_sc_succ[M_S][P_SD];
	                r_mem_resp_data_thrd_id[c][2] = core_thread_id(w_memory_resp_thrd[M_S][P_SD]);
	                w_memory_o_page_msg_ready[M_S][P_SD] = w_core_page_msg_data_ready[c];
	                if (w_memory_o_page_msg_valid[M_S][P_SD]) begin
	                    w_core_page_msg_data_valid[c] = 1'b1;
	                    w_core_page_msg_data[c]       = w_memory_o_page_msg[M_S][P_SD];
	                end
	            end
	            
	            // Map C's West to M_W's East
	            if (M_W != -1) begin
	                w_memory_req_valid[M_W][P_WI] = r_mem_req_instr_valid[c][3];
	                w_memory_req_addr[M_W][P_WI]  = memory_req_addr(r_mem_req_instr_addr[c][3], r_mem_req_instr_priv[c][3]);
	                w_memory_req_thrd[M_W][P_WI]  = memory_thread_id(c, r_mem_req_instr_thrd_id[c][3]);
	                w_memory_req_priv[M_W][P_WI]  = r_mem_req_instr_priv[c][3];
	                r_mem_req_instr_ready[c][3] = w_memory_req_ready[M_W][P_WI];
	                
	                r_mem_resp_instr_valid[c][3] = w_memory_resp_valid[M_W][P_WI];
	                w_memory_resp_ready[M_W][P_WI]  = r_mem_resp_instr_ready[c][3];
	                r_mem_resp_instr_rdata[c][3] = w_memory_resp_rdata[M_W][P_WI];
	                r_mem_resp_instr_thrd_id[c][3] = core_thread_id(w_memory_resp_thrd[M_W][P_WI]);
	                w_memory_o_page_msg_ready[M_W][P_WI] = w_core_page_msg_instr_ready[c];
	                if (w_memory_o_page_msg_valid[M_W][P_WI]) begin
	                    w_core_page_msg_instr_valid[c] = 1'b1;
	                    w_core_page_msg_instr[c]       = w_memory_o_page_msg[M_W][P_WI];
	                end

	                w_memory_req_valid[M_W][P_WD] = r_mem_req_data_valid[c][3];
	                w_memory_req_addr[M_W][P_WD]  = memory_req_addr(r_mem_req_data_addr[c][3], r_mem_req_data_priv[c][3]);
	                w_memory_req_thrd[M_W][P_WD]  = memory_thread_id(c, r_mem_req_data_thrd_id[c][3]);
	                w_memory_req_priv[M_W][P_WD]  = r_mem_req_data_priv[c][3];
	                w_memory_req_we[M_W][P_WD]    = r_mem_req_data_rw[c][3];
	                w_memory_req_is_lr[M_W][P_WD] = r_mem_req_data_lq[c][3];
	                w_memory_req_is_sc[M_W][P_WD] = r_mem_req_data_sc[c][3];
	                w_memory_req_wstrb[M_W][P_WD] = r_mem_req_data_wstrb[c][3];
	                w_memory_req_wdata[M_W][P_WD] = r_mem_req_data_wdata[c][3];
	                r_mem_req_data_ready[c][3] = w_memory_req_ready[M_W][P_WD];
	                
	                r_mem_resp_data_valid[c][3] = w_memory_resp_valid[M_W][P_WD];
	                w_memory_resp_ready[M_W][P_WD]  = r_mem_resp_data_ready[c][3];
	                r_mem_resp_data_rdata[c][3] = w_memory_resp_rdata[M_W][P_WD];
	                r_mem_resp_data_sc_ok[c][3] = w_memory_resp_sc_succ[M_W][P_WD];
	                r_mem_resp_data_thrd_id[c][3] = core_thread_id(w_memory_resp_thrd[M_W][P_WD]);
	                w_memory_o_page_msg_ready[M_W][P_WD] = w_core_page_msg_data_ready[c];
	                if (w_memory_o_page_msg_valid[M_W][P_WD]) begin
	                    w_core_page_msg_data_valid[c] = 1'b1;
	                    w_core_page_msg_data[c]       = w_memory_o_page_msg[M_W][P_WD];
	                end
	            end
        end

        for (int cl = 0; cl < NUM_CLUSTER; cl++) begin
            int C_X = get_c_x(cl);
            int C_Y = get_c_y(cl);
            int M_BOOT = (C_X % 2 == 0) ? get_m_id(C_X + 1, C_Y) : get_m_id(C_X - 1, C_Y);
            if (M_BOOT != -1) begin
                for (int sp = 0; sp < NUM_SYS_PORTS; sp++) begin
                    int P_SYS = NUM_CPU_RW_PORTS + sp;
                    w_memory_req_valid[M_BOOT][P_SYS] = w_sys_req_valid[cl][sp] &&
                                                        !w_sys_cmd_host_valid[cl] &&
                                                        !r_sys_host_vtid_valid[cl];
                    w_memory_req_addr[M_BOOT][P_SYS]  = memory_req_addr(w_sys_req_addr[cl][sp], r_sys_host_priv[cl]);
                    w_memory_req_thrd[M_BOOT][P_SYS]  = THRD_W'(w_sys_req_thrd[cl][sp]);
                    w_memory_req_priv[M_BOOT][P_SYS]  = r_sys_host_priv[cl];
                    w_memory_req_we[M_BOOT][P_SYS]    = w_sys_req_we[cl][sp];
                    w_memory_req_is_lr[M_BOOT][P_SYS] = w_sys_req_is_lr[cl][sp];
                    w_memory_req_is_sc[M_BOOT][P_SYS] = w_sys_req_is_sc[cl][sp];
                    w_memory_req_wstrb[M_BOOT][P_SYS] = w_sys_req_wstrb[cl][sp];
                    w_memory_req_wdata[M_BOOT][P_SYS] = w_sys_req_wdata[cl][sp];
                    w_sys_req_ready[cl][sp]           = !w_sys_cmd_host_valid[cl] &&
                                                        !r_sys_host_vtid_valid[cl] &&
                                                        w_memory_req_ready[M_BOOT][P_SYS];
                    w_memory_page_msg_valid[M_BOOT][P_SYS] = w_sys_cmd_host_valid[cl] || r_sys_host_vtid_valid[cl];
                    w_memory_page_msg[M_BOOT][P_SYS]       = PAGE_MSG_W'(vtid_update_msg_t'{
                        padding: '0,
                        vtid: w_sys_cmd_host_valid[cl] ? w_sys_cmd_host_vtid[cl] : r_sys_host_vtid[cl],
                        thrd_id: w_sys_cmd_host_valid[cl] ? w_sys_cmd_host_thrd[cl] : r_sys_host_thrd[cl],
                        msg_type: PAGE_MSG_VTID_UPDATE
                    });

                    w_sys_resp_valid[cl][sp]          = w_memory_resp_valid[M_BOOT][P_SYS];
                    w_sys_resp_rdata[cl][sp]          = w_memory_resp_rdata[M_BOOT][P_SYS];
                    w_sys_resp_sc_succ[cl][sp]        = w_memory_resp_sc_succ[M_BOOT][P_SYS];
                    w_sys_resp_thrd[cl][sp]           = XLEN'(w_memory_resp_thrd[M_BOOT][P_SYS]);
                    w_memory_resp_ready[M_BOOT][P_SYS] = w_sys_resp_ready[cl][sp];
                end
            end
        end
    end

    /* ---- */

    /* external */
    logic [THREADS_PER_CLUSTER-1:0] w_cluster_wake_vec [NUM_CLUSTER-1:0];
    logic page_completion_pending;
    logic [THRD_W-1:0] page_completion_thrd;

    /* Convert the external completion pulse into an acknowledged level.  A
     * new page request consumes any old completion; the completed request
     * then sets the level until the next request begins. */
    always_ff @(posedge i_clk or negedge rst_fabric_n) begin
        if (!rst_fabric_n) begin
            page_completion_pending <= 1'b0;
            page_completion_thrd <= '0;
        end else if (i_page_transfer_done)
            page_completion_pending <= 1'b1;
        else if (o_page_req_valid && i_page_req_ready) begin
            page_completion_pending <= 1'b0;
            page_completion_thrd <= w_memory_page_req_thrd[0];
        end
`ifdef VERILATOR
        // if (i_rst_n && o_page_req_valid && i_page_req_ready)
        //     $display("[PAGERTL:REQ] thrd=%0d addr=%0h we=%0b", w_memory_page_req_thrd[0], o_page_req_addr, o_page_req_we);
        // if (i_rst_n && i_page_transfer_done)
        //     $display("[PAGERTL:DONE] thrd=%0d", page_completion_thrd);
`endif
    end
    for (genvar cl = 0; cl < NUM_CLUSTER; cl++) begin
        always_comb begin
            w_cluster_wake_vec[cl] = '0;
            for (int k = 0; k < CORES_PER_CLUSTER; k++) begin
                w_cluster_wake_vec[cl] = w_cluster_wake_vec[cl] | r_ipi_vector[cl*CORES_PER_CLUSTER + k];
            end
        end
    end

	    for (genvar cl = 0; cl < NUM_CLUSTER; cl++) begin : gen_cluster_reset
	        reset_sync cluster_reset_sync (
	            .i_clk         (i_clk),
	            .i_async_rst_n (i_rst_n),
	            .o_rst_n       (rst_cluster_n[cl])
	        );
	    end

	    for (genvar c = 0; c < NUM_CORES; c++) begin : gen_core_clock_reset
	        localparam int CLUSTER_ID = c / CORES_PER_CLUSTER;
	        localparam int CORE_LOCAL_ID = c % CORES_PER_CLUSTER;
	        localparam int C_X = get_c_x(CLUSTER_ID);
	        localparam int C_Y = get_c_y(CLUSTER_ID);
	        assign w_core_clk[c]     = i_clk;
	        assign w_core_rst_n[c]   = rst_cluster_n[CLUSTER_ID];
	        for (genvar t = 0; t < NUM_HW_THRDS; t++) begin
	            assign w_core_wake_intr_vec[c][t] = w_cluster_wake_vec[CLUSTER_ID][t * CORES_PER_CLUSTER + CORE_LOCAL_ID] |
	                (w_sys_intr[CLUSTER_ID] && THRD_W'(w_sys_intr_thrd[CLUSTER_ID]) == THRD_W'(t)) |
	                ((c == 0 && t == 0) ? i_host_console_pending : 1'b0) |
	                ((THRD_W'(t * CORES_PER_CLUSTER + CORE_LOCAL_ID) == page_completion_thrd)
	                    ? page_completion_pending : 1'b0);
	            assign w_core_thrd_id_vec[c][t] = XLEN'(
	                (XLEN'(C_Y) << (THREAD_OFFSET_BITS + MESH_COORD_BITS)) |
	                (XLEN'(C_X) << THREAD_OFFSET_BITS) |
	                XLEN'(t * CORES_PER_CLUSTER + CORE_LOCAL_ID)
	            );
	        end
	    end
    for (genvar m = 0; m < NUM_MEM; m++) begin : gen_memory_clock_reset
        assign w_memory_clk[m]   = i_clk;
        reset_sync memory_reset_sync (
            .i_clk         (w_memory_clk[m]),
            .i_async_rst_n (i_rst_n),
            .o_rst_n       (rst_mem_n[m])
        );
        assign w_memory_rst_n[m] = rst_mem_n[m];
    end
    assign w_uart_mmio_clk       = i_clk;
    assign w_uart_mmio_rst_n     = rst_periph_n;
    assign o_uart_tx             = w_uart_mmio_tx;
    assign w_uart_mmio_rx        = i_uart_rx;

    /* Simulator direct access to the uart (only cluster0, core0)*/
    import "DPI-C" context function void sim_uart_tx(input byte data);
    import "DPI-C" context function int sim_uart_rx();
    import "DPI-C" context function longint unsigned sim_console_rx_batch();

    logic                                               r_sim_uart_rx_resp_valid;
    logic                                               r_sim_uart_rx_resp_pending;
    logic [XLEN-1:0]                                    r_sim_uart_rx_resp_rdata;
    logic [$clog2(NUM_CORES > 1 ? NUM_CORES : 2)-1:0]  r_sim_uart_rx_resp_core;
    logic [THRD_W-1:0]                                  r_sim_uart_rx_resp_thrd;

	    logic [NUM_CORES-1:0] w_uart_req_valid_vec;
	    logic [NUM_CORES-1:0] w_uart_grant;
	    logic [$clog2(NUM_CORES > 1 ? NUM_CORES : 2)-1:0] r_uart_resp_core;
        logic [$clog2(XLEN/8)-1:0] r_uart_resp_byte_offset;
    
	    for (genvar c = 0; c < NUM_CORES; c++) begin
	        assign w_uart_req_valid_vec[c] = 
	            w_core_req_data_valid[c] && 
	            w_core_req_data_priv[c] == 2'b11 &&
            w_core_req_data_addr[c] >= UART_BASE_ADDR &&
            w_core_req_data_addr[c] <= UART_END_ADDR;
    end
    
    always_comb begin
        w_uart_grant = '0;
	        for (int k = 0; k < NUM_CORES; k++) begin
            if (w_uart_req_valid_vec[k]) begin
                w_uart_grant[k] = 1'b1;
                break;
            end
        end
    end

    always_comb begin
        w_uart_mmio_req_valid = 1'b0;
        w_uart_mmio_req_we    = 1'b0;
        w_uart_mmio_req_thrd  = '0;
        w_uart_mmio_req_is_lr = 1'b0;
        w_uart_mmio_req_is_sc = 1'b0;
        w_uart_mmio_req_priv  = '0;
        w_uart_mmio_req_addr  = '0;
        w_uart_mmio_req_wdata = '0;
        w_uart_mmio_req_wstrb = '0;
	        for (int k = 0; k < NUM_CORES; k++) begin
            if (w_uart_grant[k] && (w_core_req_data_rw[k] ||
                (w_core_req_data_addr[k] != (UART_BASE_ADDR + 64'h8) &&
                 w_core_req_data_addr[k] != FASTCON_RX_ADDR))) begin
                w_uart_mmio_req_valid = 1'b1;
                w_uart_mmio_req_we    = w_core_req_data_rw[k];
                w_uart_mmio_req_thrd  = THRD_W'(w_core_req_data_thrd_id[k]);
                w_uart_mmio_req_priv  = w_core_req_data_priv[k];
                w_uart_mmio_req_addr  = w_core_req_data_addr[k];
                w_uart_mmio_req_wdata = w_core_req_data_wdata[k] >>
                    (w_core_req_data_addr[k][$clog2(XLEN/8)-1:0] * 8);
                w_uart_mmio_req_wstrb = w_core_req_data_wstrb[k] >>
                    w_core_req_data_addr[k][$clog2(XLEN/8)-1:0];
                break;
            end
        end
    end

    always_comb begin
        w_uart_mmio_resp_ready = 1'b0;
	        for (int k = 0; k < NUM_CORES; k++) begin
            if (r_uart_resp_core == $bits(r_uart_resp_core)'(k)) begin
                w_uart_mmio_resp_ready = w_core_resp_data_ready[k];
            end
        end
    end

    // Helper logic for core 0 simulation UART hooks (which only applies to whichever core gets the grant)
    logic w_sim_uart_rx_req_fire;
    always_comb begin
        w_sim_uart_rx_req_fire = 1'b0;
	        for (int k = 0; k < NUM_CORES; k++) begin
            if (w_uart_grant[k] && !r_sim_uart_rx_resp_valid &&
                !r_sim_uart_rx_resp_pending &&
                !w_core_req_data_rw[k] &&
                (w_core_req_data_addr[k] == (UART_BASE_ADDR + 64'h8) ||
                 w_core_req_data_addr[k] == FASTCON_RX_ADDR)) begin
                w_sim_uart_rx_req_fire = 1'b1;
            end
        end
    end

    for (genvar c = 0; c < NUM_CORES; c++) begin : gen_core_data_resp_mux
        wire w_core_ipi_req_valid =
            w_core_req_data_valid[c] &&
            w_core_req_data_priv[c] == 2'b11 &&
            is_ipi_addr(w_core_req_data_addr[c]);
        wire w_core_oob_req_valid =
            w_core_req_data_valid[c] &&
            is_dummy_oob_data_addr(w_core_req_data_addr[c], w_core_req_data_priv[c]);
        wire w_core_sys_req_valid =
            w_core_req_data_valid[c] &&
            is_sys_mmio_addr(w_core_req_data_addr[c], w_core_req_data_priv[c]);
        localparam int CORE_CLUSTER_ID = c / CORES_PER_CLUSTER;
        localparam int CORE_LOCAL_ID = c % CORES_PER_CLUSTER;
            
        logic w_core_uart_req_valid =
            w_core_req_data_valid[c] &&
            w_core_req_data_priv[c] == 2'b11 &&
            w_core_req_data_addr[c] >= UART_BASE_ADDR &&
            w_core_req_data_addr[c] <= UART_END_ADDR;
        logic w_core_uart_rx_req =
            w_core_uart_req_valid && !w_core_req_data_rw[c] &&
            (w_core_req_data_addr[c] == (UART_BASE_ADDR + 64'h8) ||
             w_core_req_data_addr[c] == FASTCON_RX_ADDR);
        logic w_core_ipi_req_valid_tmp =
            w_core_req_data_valid[c] &&
            w_core_req_data_priv[c] == 2'b11 &&
            is_ipi_addr(w_core_req_data_addr[c]);
                
            logic [XLEN-1:0] w_core_timer_resp_rdata_mux;
            logic [$clog2(NUM_HW_THRDS)-1:0] w_core_timer_resp_thrd_mux;
            logic w_core_timer_resp_valid_any;
            logic w_core_timer_req_valid_any;

            always_comb begin
                w_core_timer_resp_rdata_mux = '0;
                w_core_timer_resp_thrd_mux = '0;
                w_core_timer_resp_valid_any = 1'b0;
                for (int t = 0; t < NUM_HW_THRDS; t++) begin
                    if (w_core_timer_resp_valid[c][t]) begin
                        w_core_timer_resp_rdata_mux |= w_core_timer_resp_rdata[c][t];
                        w_core_timer_resp_thrd_mux |= $clog2(NUM_HW_THRDS)'(t);
                        w_core_timer_resp_valid_any = 1'b1;
                    end
                end
                w_core_timer_req_valid_any = is_timer_mmio_addr(w_core_req_data_addr[c], w_core_req_data_priv[c]) && w_core_req_data_valid[c];
            end

	        assign w_core_req_data_ready[c] =
	            w_core_uart_req_valid ? (w_uart_grant[c] &&
                    (w_core_uart_rx_req ?
                        (!r_sim_uart_rx_resp_valid && !r_sim_uart_rx_resp_pending) :
                        w_uart_mmio_req_ready)) :
	            w_core_ipi_req_valid_tmp  ? !r_ipi_resp_valid[c] :
                w_core_sys_req_valid  ? (w_sys_mmio_grant[c] && w_sys_mmio_req_ready[CORE_CLUSTER_ID]) :
                w_core_oob_req_valid  ? !r_oob_resp_valid[c] :
                w_core_timer_req_valid_any ? 1'b1 :
	                                    w_router_req_data_ready[c];
	        assign w_core_resp_data_valid[c] =
	            (c == r_sim_uart_rx_resp_core && r_sim_uart_rx_resp_valid) ||
	            (c == r_uart_resp_core && w_uart_mmio_resp_valid) ||
                (w_sys_mmio_resp_valid[CORE_CLUSTER_ID] && r_sys_resp_core[CORE_CLUSTER_ID] == $bits(r_sys_resp_core[CORE_CLUSTER_ID])'(CORE_LOCAL_ID)) ||
                r_ipi_resp_valid[c] || r_oob_resp_valid[c] || w_core_timer_resp_valid_any || w_router_resp_data_valid[c];
	        assign w_core_resp_data_rdata[c] =
	            (c == r_sim_uart_rx_resp_core && r_sim_uart_rx_resp_valid) ? XLEN'(r_sim_uart_rx_resp_rdata) :
	            r_ipi_resp_valid[c] ? r_ipi_resp_rdata[c] :
                r_oob_resp_valid[c] ? '0 :
                w_core_timer_resp_valid_any ? w_core_timer_resp_rdata_mux :
                (w_sys_mmio_resp_valid[CORE_CLUSTER_ID] && r_sys_resp_core[CORE_CLUSTER_ID] == $bits(r_sys_resp_core[CORE_CLUSTER_ID])'(CORE_LOCAL_ID)) ?
                    w_sys_mmio_resp_rdata[CORE_CLUSTER_ID] :
	            (c == r_uart_resp_core && w_uart_mmio_resp_valid) ?
                    (XLEN'(w_uart_mmio_resp_rdata) << (r_uart_resp_byte_offset * 8)) :
	                w_router_resp_data_rdata[c];
	        assign w_core_resp_data_sc_ok[c] =
	            ((c == r_sim_uart_rx_resp_core && r_sim_uart_rx_resp_valid) ||
	             (c == r_uart_resp_core && w_uart_mmio_resp_valid) ||
                 (w_sys_mmio_resp_valid[CORE_CLUSTER_ID] && r_sys_resp_core[CORE_CLUSTER_ID] == $bits(r_sys_resp_core[CORE_CLUSTER_ID])'(CORE_LOCAL_ID)) ||
                 r_ipi_resp_valid[c] || r_oob_resp_valid[c] || w_core_timer_resp_valid_any) ? 1'b0 : w_router_resp_data_sc_ok[c];
	        assign w_core_resp_data_thrd_id[c] =
	            (c == r_sim_uart_rx_resp_core && r_sim_uart_rx_resp_valid) ? r_sim_uart_rx_resp_thrd :
	            r_ipi_resp_valid[c] ? r_ipi_resp_thrd[c] :
                r_oob_resp_valid[c] ? r_oob_resp_thrd[c] :
                w_core_timer_resp_valid_any ? w_core_timer_resp_thrd_mux :
                (w_sys_mmio_resp_valid[CORE_CLUSTER_ID] && r_sys_resp_core[CORE_CLUSTER_ID] == $bits(r_sys_resp_core[CORE_CLUSTER_ID])'(CORE_LOCAL_ID)) ?
                    r_sys_resp_thrd[CORE_CLUSTER_ID] :
	            (c == r_uart_resp_core && w_uart_mmio_resp_valid) ? r_ipi_resp_thrd[c] :
	                                                            w_router_resp_data_thrd_id[c];
	    end

    always_ff @(posedge i_clk or negedge rst_fabric_n) begin
        if (!rst_fabric_n) begin
            r_sim_uart_rx_resp_valid <= 1'b0;
            r_sim_uart_rx_resp_pending <= 1'b0;
            r_sim_uart_rx_resp_rdata <= XLEN'({1'b1, 31'd0}) << 32;
            r_sim_uart_rx_resp_core  <= '0;
            r_sim_uart_rx_resp_thrd  <= '0;
            for (int c = 0; c < NUM_CORES; c++) begin
                r_ipi_vector[c]       <= '0;
                r_ipi_resp_valid[c]   <= 1'b0;
                r_ipi_resp_rdata[c]   <= '0;
                r_ipi_resp_thrd[c]    <= '0;
                r_ipi_wake_hold[c]    <= '0;
                r_oob_resp_valid[c]   <= 1'b0;
                r_oob_resp_thrd[c]    <= '0;
                r_core_page_msg_instr_valid[c] <= 1'b0;
                r_core_page_msg_instr[c]       <= '0;
                r_core_page_msg_data_valid[c]  <= 1'b0;
                r_core_page_msg_data[c]        <= '0;
                for (int t = 0; t < NUM_HW_THRDS; t++) begin
                    r_core_active_vtid[c][t] <= '0;
                end
            end
            for (int m = 0; m < NUM_MEM; m++) begin
                for (int p = 0; p < NUM_RW_PORTS; p++) begin
                    r_memory_o_page_msg_ready[m][p] <= 1'b0;
                end
            end
            for (int cl = 0; cl < NUM_CLUSTER; cl++) begin
                r_sys_resp_core[cl] <= '0;
                r_sys_resp_thrd[cl] <= '0;
                r_sys_host_thrd[cl] <= '0;
                r_sys_host_vtid[cl] <= '0;
                r_sys_host_vtid_valid[cl] <= 1'b0;
                r_sys_host_priv[cl] <= PRIV_MODE_M;
            end
            r_uart_resp_core          <= '0;
            r_uart_resp_byte_offset   <= '0;
        end else begin
            if (r_sim_uart_rx_resp_pending) begin
                r_sim_uart_rx_resp_pending <= 1'b0;
                r_sim_uart_rx_resp_valid <= 1'b1;
            end
            if (r_sim_uart_rx_resp_valid &&
                w_core_resp_data_ready[r_sim_uart_rx_resp_core]) begin
                r_sim_uart_rx_resp_valid <= 1'b0;
            end
            for (int m = 0; m < NUM_MEM; m++) begin
                for (int p = 0; p < NUM_RW_PORTS; p++) begin
                    r_memory_o_page_msg_ready[m][p] <= w_memory_o_page_msg_ready[m][p];
                end
            end
            for (int c = 0; c < NUM_CORES; c++) begin
                r_core_page_msg_instr_valid[c] <= w_core_page_msg_instr_valid[c];
                r_core_page_msg_instr[c]       <= w_core_page_msg_instr[c];
                r_core_page_msg_data_valid[c]  <= w_core_page_msg_data_valid[c];
                r_core_page_msg_data[c]        <= w_core_page_msg_data[c];
                if (w_core_page_msg_valid[c] && w_core_page_msg_ready[c]) begin
                    generic_page_msg_t gen_msg;
                    gen_msg = w_core_page_msg[c];
                    if (gen_msg.msg_type == PAGE_MSG_VTID_UPDATE) begin
                        vtid_update_msg_t vtid_msg;
                        vtid_msg = w_core_page_msg[c];
                        r_core_active_vtid[c][core_thread_id(vtid_msg.thrd_id)] <= vtid_msg.vtid;
                    end
                end
                if (r_ipi_resp_valid[c] && w_core_resp_data_ready[c]) begin
                    r_ipi_resp_valid[c] <= 1'b0;
                end
                if (r_oob_resp_valid[c] && w_core_resp_data_ready[c]) begin
                    r_oob_resp_valid[c] <= 1'b0;
                end
                if (r_ipi_wake_hold[c] != '0) begin
                    r_ipi_wake_hold[c] <= r_ipi_wake_hold[c] - 1'b1;
                    if (r_ipi_wake_hold[c] == 8'd1) begin
                        r_ipi_vector[c] <= '0;
                    end
                end
            end
            for (int k = 0; k < NUM_CORES; k++) begin
	                if (w_uart_grant[k] && w_uart_mmio_req_ready &&
                        (w_core_req_data_rw[k] ||
                         (w_core_req_data_addr[k] != (UART_BASE_ADDR + 64'h8) &&
                          w_core_req_data_addr[k] != FASTCON_RX_ADDR))) begin
	                    r_uart_resp_core <= $bits(r_uart_resp_core)'(k);
                        r_uart_resp_byte_offset <=
                            w_core_req_data_addr[k][$clog2(XLEN/8)-1:0];
	                end
	            end
	            for (int k = 0; k < NUM_CORES; k++) begin
	                if (w_uart_grant[k] && w_uart_mmio_req_ready &&
                        (w_core_req_data_rw[k] ||
                         (w_core_req_data_addr[k] != (UART_BASE_ADDR + 64'h8) &&
                          w_core_req_data_addr[k] != FASTCON_RX_ADDR)) &&
                        !(r_ipi_resp_valid[k] && !w_core_resp_data_ready[k])) begin
	                    r_ipi_resp_thrd[k] <= w_core_req_data_thrd_id[k];
	                end
	            end
            for (int cl = 0; cl < NUM_CLUSTER; cl++) begin
                int c_x;
                int c_y;
                int m_boot;
                int p_sys;

                c_x = get_c_x(cl);
                c_y = get_c_y(cl);
                m_boot = (c_x % 2 == 0) ? get_m_id(c_x + 1, c_y) : get_m_id(c_x - 1, c_y);
                p_sys = NUM_CPU_RW_PORTS;

                if (r_sys_host_vtid_valid[cl] && m_boot != -1 &&
                    w_memory_page_msg_ready[m_boot][p_sys]) begin
                    r_sys_host_vtid_valid[cl] <= 1'b0;
                end
                for (int k = 0; k < CORES_PER_CLUSTER; k++) begin
                    int c = cl * CORES_PER_CLUSTER + k;
                    if (w_sys_mmio_grant[c] && w_sys_cmd_host_valid[cl]) begin
                        r_sys_resp_core[cl] <= $bits(r_sys_resp_core[cl])'(k);
                        r_sys_resp_thrd[cl] <= w_core_req_data_thrd_id[c];
                        r_sys_host_thrd[cl] <= memory_thread_id(c, w_core_req_data_thrd_id[c]);
                        r_sys_host_vtid[cl] <= r_core_active_vtid[c][w_core_req_data_thrd_id[c]];
                        r_sys_host_vtid_valid[cl] <= 1'b1;
                        r_sys_host_priv[cl] <= PRIV_MODE_U;
                    end else if (w_sys_mmio_grant[c] && w_sys_mmio_req_ready[cl]) begin
                        r_sys_resp_core[cl] <= $bits(r_sys_resp_core[cl])'(k);
                        r_sys_resp_thrd[cl] <= w_core_req_data_thrd_id[c];
                    end
                end
            end
	            for (int k = 0; k < NUM_CORES; k++) begin
                if (w_uart_grant[k] && w_core_req_data_valid[k] && w_core_req_data_ready[k] &&
                    w_core_req_data_rw[k] &&
                    w_core_req_data_addr[k] == UART_BASE_ADDR) begin
                    sim_uart_tx(w_core_req_data_wdata[k][7:0]);
                end
            end
            if (w_sim_uart_rx_req_fire) begin
                int rx_val;
                r_sim_uart_rx_resp_pending <= 1'b1;
                for (int k = 0; k < NUM_CORES; k++) begin
                    if (w_uart_grant[k]) begin
                        if (w_core_req_data_addr[k] == FASTCON_RX_ADDR) begin
                            r_sim_uart_rx_resp_rdata <= sim_console_rx_batch();
                        end else begin
                            rx_val = sim_uart_rx();
                            if (rx_val[31])
                                r_sim_uart_rx_resp_rdata <= XLEN'({1'b0, 23'd0, rx_val[7:0]}) << 32;
                            else
                                r_sim_uart_rx_resp_rdata <= XLEN'({1'b1, 31'd0}) << 32;
                        end
                        r_sim_uart_rx_resp_core <= $bits(r_sim_uart_rx_resp_core)'(k);
                        r_sim_uart_rx_resp_thrd <= w_core_req_data_thrd_id[k];
                    end
                end
            end
            for (int c = 0; c < NUM_CORES; c++) begin
                if (w_core_req_data_valid[c] &&
                    is_dummy_oob_data_addr(w_core_req_data_addr[c], w_core_req_data_priv[c]) &&
                    !r_oob_resp_valid[c]) begin
                    r_oob_resp_valid[c] <= 1'b1;
                    r_oob_resp_thrd[c]  <= w_core_req_data_thrd_id[c];
                end
                if (w_core_req_data_valid[c] &&
                    w_core_req_data_priv[c] == 2'b11 &&
                    is_ipi_addr(w_core_req_data_addr[c]) &&
                    !r_ipi_resp_valid[c]) begin
                    int ipi_word;
                    ipi_word = ipi_word_index(w_core_req_data_addr[c]);
                    r_ipi_resp_valid[c] <= 1'b1;
                    r_ipi_resp_thrd[c] <= w_core_req_data_thrd_id[c];
                    if (w_core_req_data_rw[c]) begin
                        for (int b = 0; b < THREADS_PER_CLUSTER; b++) begin
                            if ((b / XLEN) == ipi_word) begin
                                r_ipi_vector[c][b] <= w_core_req_data_wdata[c][b % XLEN];
                            end
                        end
                        r_ipi_wake_hold[c] <= 8'hff;
                        r_ipi_resp_rdata[c] <= '0;
                    end else begin
                        r_ipi_resp_rdata[c] <= '0;
                        for (int b = 0; b < THREADS_PER_CLUSTER; b++) begin
                            if ((b / XLEN) == ipi_word) begin
                                r_ipi_resp_rdata[c][b % XLEN] <= r_ipi_vector[c][b];
                            end
                        end
                    end
                end
            end
        end
    end
    /* ---- */

    /* Simulator direct access to the page_engine interface to the memory (only memory0)*/
    assign o_sim_page_msg_valid = w_memory_o_page_msg_valid[0][0];
    assign o_sim_page_msg       = w_memory_o_page_msg      [0][0];
    assign o_page_req_we        = w_memory_page_req_we     [0];
    assign o_page_req_valid     = w_memory_page_req_valid  [0];
    assign o_page_req_addr      = w_memory_page_req_addr   [0];
    assign o_page_req_wdata     = w_memory_page_req_wdata  [0];
    assign w_memory_page_req_ready [0] = i_page_req_ready;
    assign w_memory_page_resp_addr  [0] = i_page_resp_addr;
    assign w_memory_page_resp_we    [0] = i_page_resp_we;
    assign w_memory_page_resp_wdata [0] = i_page_resp_wdata;
    assign w_memory_page_resp_valid [0] = i_page_resp_valid;
    assign o_page_resp_ready = w_memory_page_resp_ready[0];

    for (genvar m = 1; m < NUM_MEM; m++) begin : gen_unused_page_engine_if
        assign w_memory_page_req_ready [m] = 1'b0;
        assign w_memory_page_resp_addr  [m] = '0;
        assign w_memory_page_resp_we    [m] = 1'b0;
        assign w_memory_page_resp_wdata [m] = '0;
        assign w_memory_page_resp_valid [m] = 1'b0;
    end

    assign m_axi4_page_awaddr  = 32'd0;
    assign m_axi4_page_awlen   = 8'd0;
    assign m_axi4_page_awsize  = 3'd0;
    assign m_axi4_page_awburst = 2'd0;
    /* ---- */

endmodule: soc_multi
